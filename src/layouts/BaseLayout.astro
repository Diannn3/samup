---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { organization } from '../data/organization';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = `${organization.name} | SAM-UP`,
  description = 'The Society of Applied Mathematics of UPLB — a self-governing academic organization promoting the relevance and wider application of Applied Mathematics.',
  image = '/keyshot-samup-piu-yellow.jpg',
  canonicalURL: requestedCanonicalURL
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = requestedCanonicalURL ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);
const socialImage = Astro.site ? new URL(image, Astro.site).href : image;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: organization.name,
  alternateName: organization.shortName,
  foundingDate: '1984-11-27',
  description,
  ...(canonicalURL ? { url: canonicalURL } : {}),
  ...(Astro.site ? { logo: new URL('/sam-up-seal.png', Astro.site).href } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Institute of Mathematical Sciences and Physics, UPLB',
    addressLocality: 'Los Baños',
    addressRegion: 'Laguna',
    addressCountry: 'PH'
  }
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta name="theme-color" content="#080807" />

    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="SAM-UP seal and piu identity artwork" />

    <meta property="twitter:card" content="summary_large_image" />
    {canonicalURL && <meta property="twitter:url" content={canonicalURL} />}
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />
    <meta property="twitter:image:alt" content="SAM-UP seal and piu identity artwork" />

    <link rel="icon" type="image/png" href="/sam-up-seal.png" />

    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--background)] text-[var(--foreground)] antialiased relative overflow-x-hidden">
    <div class="fixed inset-x-0 top-0 h-[38rem] pointer-events-none z-0 bg-[radial-gradient(ellipse_at_top,rgba(228,189,79,0.055),transparent_68%)]" aria-hidden="true" />

    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    <Header currentPath={currentPath} />

    <main id="main-content" class="flex-grow pt-20 relative z-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
