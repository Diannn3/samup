---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';
import { ArrowRight, Building2, Handshake, Megaphone, BookOpen, ShieldCheck, Mail } from 'lucide-react';
---

<BaseLayout
  title="Partner with SAM-UP | Society of Applied Mathematics of UPLB"
  description="A public-safe introduction to collaboration with the Society of Applied Mathematics of UPLB."
>
  <section class="relative overflow-hidden border-b border-[var(--border)] py-20 sm:py-24 lg:py-28">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,rgba(240,204,78,0.14),transparent_34%)] pointer-events-none"
      aria-hidden="true"
    />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-4xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">Collaboration</p>
        <h1 class="mt-4 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight text-[var(--foreground)]">
          Partner with <span class="text-gold-gradient">SAM-UP</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          Work with a UPLB academic organization built around the relevance and wider application of Applied
          Mathematics. This page is an inquiry surface—not a sponsorship package, automatic approval, or
          substitute for SAM-UP's internal partnership process.
        </p>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-16">
    <section class="grid md:grid-cols-3 gap-6">
      <article class="frosted-glass-card p-7">
        <div class="w-11 h-11 rounded-xl border border-[var(--border-primary)] bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)]">
          <Handshake className="w-5 h-5" aria-hidden="true" />
        </div>
        <h2 class="mt-5 font-display font-bold text-xl text-[var(--foreground)]">Event collaboration</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
          Explore support, co-promotion, resources, or other mutually defined contributions for an approved
          activity.
        </p>
      </article>

      <article class="frosted-glass-card p-7">
        <div class="w-11 h-11 rounded-xl border border-[var(--border-primary)] bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)]">
          <Megaphone className="w-5 h-5" aria-hidden="true" />
        </div>
        <h2 class="mt-5 font-display font-bold text-xl text-[var(--foreground)]">Media & promotion</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
          Discuss public-facing promotional collaboration when there is a clear, approved scope and reciprocal
          value.
        </p>
      </article>

      <article class="frosted-glass-card p-7">
        <div class="w-11 h-11 rounded-xl border border-[var(--border-primary)] bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)]">
          <BookOpen className="w-5 h-5" aria-hidden="true" />
        </div>
        <h2 class="mt-5 font-display font-bold text-xl text-[var(--foreground)]">
          Math-centered initiatives
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
          Propose educational or promotional work that helps make mathematics and its applications more
          understandable and relevant.
        </p>
      </article>
    </section>

    <section class="grid lg:grid-cols-12 gap-8">
      <article class="lg:col-span-7 frosted-glass-card p-8 sm:p-10">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <Building2 className="w-4 h-4" aria-hidden="true" />
          <span>Why collaborate</span>
        </div>
        <h2 class="mt-4 font-display font-bold text-2xl sm:text-4xl text-[var(--foreground)]">
          Applied Mathematics is a bridge between abstract reasoning and real-world decisions.
        </h2>
        <p class="mt-5 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          SAM-UP's constitutional purpose includes promoting the relevance, deeper appreciation, and wider
          application of Applied Mathematics to Philippine society. Good collaborations should make that
          purpose more tangible—not merely add logos to a poster.
        </p>

        <div class="mt-7 grid sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl border border-[var(--border)] bg-white/[0.03]">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
              Useful proposals
            </div>
            <p class="mt-2 text-sm text-[var(--foreground)]">
              Clear audience, objective, contribution, timeline, and public value.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-[var(--border)] bg-white/[0.03]">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
              Public proof
            </div>
            <p class="mt-2 text-sm text-[var(--foreground)]">
              Only approved case studies, acknowledgments, and public deliverables should appear on this site.
            </p>
          </div>
        </div>
      </article>

      <aside class="lg:col-span-5 frosted-glass-card p-8 sm:p-10">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <ShieldCheck className="w-4 h-4" aria-hidden="true" />
          <span>Governance guardrail</span>
        </div>
        <h2 class="mt-4 font-display font-bold text-2xl text-[var(--foreground)]">
          An inquiry is not an agreement.
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-[var(--muted-foreground)]">
          Partnership and sponsorship commitments remain subject to SAM-UP's applicable internal review and
          approval processes. This public page intentionally does not expose internal rates, negotiation
          notes, credentials, draft obligations, or unapproved commitments.
        </p>
      </aside>
    </section>

    <section class="relative overflow-hidden rounded-[1.75rem] border border-[var(--border-primary)] bg-[var(--primary)] text-[var(--primary-foreground)] p-8 sm:p-10 lg:p-12">
      <div class="max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] opacity-70">Start a conversation</p>
        <h2 class="mt-4 font-display font-black text-3xl sm:text-5xl tracking-tight">
          Bring a clear problem, audience, or opportunity.
        </h2>
        <p class="mt-4 max-w-2xl text-sm sm:text-base leading-relaxed opacity-80">
          Introduce your organization, the proposed collaboration, target audience, intended dates, and what
          each side could contribute. SAM-UP can then evaluate whether the proposal fits its objectives and
          processes.
        </p>
        <a
          href={`mailto:${organization.socials.email}?subject=Partnership%20Inquiry%20for%20SAM-UP`}
          class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--background)] px-6 py-3.5 text-sm font-bold text-[var(--foreground)] transition-transform hover:-translate-y-0.5"
        >
          <Mail className="w-4 h-4 text-[var(--primary)]" aria-hidden="true" />
          Email a partnership inquiry
          <ArrowRight class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
