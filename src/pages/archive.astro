---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Archive, Newspaper, Users, ShieldCheck } from 'lucide-react';
---

<BaseLayout
  title="Archive | Society of Applied Mathematics of UPLB"
  description="Public-safe historical and publication archives of the Society of Applied Mathematics of UPLB."
>
  <section class="border-b border-[var(--border)] py-20 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">
          <Archive class="w-4 h-4" aria-hidden="true" />
          <span>Organizational memory</span>
        </div>
        <h1 class="mt-5 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-[-0.035em] leading-[0.98] text-[var(--foreground)]">
          The public <span class="text-gold-gradient">archive.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          Historical records are useful only when their scope is clear. These archives separate documented
          leadership history and approved publications from claims about the present organization.
        </p>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="grid lg:grid-cols-2 gap-6">
      <a
        href="/alumni"
        class="group rounded-[1.5rem] border border-[var(--border)] p-7 sm:p-8 hover:border-[var(--border-primary)] transition-colors"
      >
        <Users class="w-6 h-6 text-[var(--primary)]" aria-hidden="true" />
        <div class="mt-7 font-mono text-[10px] uppercase tracking-wider text-[var(--muted-foreground)]">
          Historical dataset
        </div>
        <h2 class="mt-3 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">
          Leadership Archive
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)]">
          Search documented Senior Executive terms from the repository's historical archive. Entries are
          explicitly historical and are not presented as a current Executive Committee roster.
        </p>
        <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)]">
          Browse leadership records
          <ArrowRight class="w-4 h-4" aria-hidden="true" />
        </span>
      </a>

      <a
        href="/chronicle"
        class="group rounded-[1.5rem] border border-[var(--border)] p-7 sm:p-8 hover:border-[var(--border-primary)] transition-colors"
      >
        <Newspaper class="w-6 h-6 text-[var(--primary)]" aria-hidden="true" />
        <div class="mt-7 font-mono text-[10px] uppercase tracking-wider text-[var(--muted-foreground)]">
          Publication archive
        </div>
        <h2 class="mt-3 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">
          The Chronicle
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)]">
          Approved issues and articles will be listed only after source, publication date, authorship, and
          public visibility have been verified.
        </p>
        <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)]">
          Open Chronicle archive
          <ArrowRight class="w-4 h-4" aria-hidden="true" />
        </span>
      </a>
    </div>

    <section class="mt-10 rounded-[1.5rem] border border-[var(--border)] p-7 flex items-start gap-4">
      <ShieldCheck class="w-5 h-5 text-[var(--primary)] shrink-0 mt-0.5" aria-hidden="true" />
      <div>
        <h2 class="font-display font-bold text-xl text-[var(--foreground)]">Archive labels matter.</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
          Historical entries are not used to infer current officers, current membership, active programs, or
          present organizational policy.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
