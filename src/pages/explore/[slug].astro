---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShortestPathDiagram from '../../components/math/ShortestPathDiagram.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft, BookOpen, ShieldCheck } from 'lucide-react';

export async function getStaticPaths() {
  const entries = await getCollection(
    'appliedMath',
    ({ data }) =>
      data.evidence.visibility === 'public' &&
      data.evidence.status !== 'unknown' &&
      data.evidence.status !== 'blocked' &&
      data.evidence.status !== 'needs-approval',
  );

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'appliedMath'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<BaseLayout title={`${data.title} | Explore Applied Mathematics | SAM-UP`} description={data.summary}>
  <article>
    <header class="relative overflow-hidden border-b border-[var(--border)] py-16 sm:py-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <a
          href="/explore"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--muted-foreground)] hover:text-[var(--primary)] transition-colors"
        >
          <ArrowLeft class="w-4 h-4" aria-hidden="true" />
          Explore Applied Mathematics
        </a>

        <div class="mt-8 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--primary)]">
          <BookOpen class="w-4 h-4" aria-hidden="true" />
          <span>
            {data.level} • {data.concept}
          </span>
        </div>

        <h1 class="mt-4 max-w-4xl font-display font-black text-4xl sm:text-6xl tracking-[-0.03em] leading-[1.02] text-[var(--foreground)]">
          {data.title}
        </h1>
        <p class="mt-5 max-w-3xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          {data.summary}
        </p>

        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-xs font-mono text-[var(--muted-foreground)]">
          <span>Published {data.publishedAt}</span>
          {data.updatedAt && <span>Updated {data.updatedAt}</span>}
          <span class="inline-flex items-center gap-1.5">
            <ShieldCheck class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
            Reviewed {data.evidence.reviewedAt}
          </span>
        </div>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      {data.slug === 'shortest-paths' && (
        <div class="mb-12">
          <ShortestPathDiagram />
        </div>
      )}

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
        <div class="lg:col-span-8">
          <div class="article-prose">
            <Content />
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-28 space-y-6">
            <section class="rounded-2xl border border-[var(--border)] p-5">
              <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--primary)]">
                Accessibility description
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)]">
                {data.accessibilityDescription}
              </p>
            </section>

            <section class="rounded-2xl border border-[var(--border)] p-5">
              <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--primary)]">Sources</div>
              <ul class="mt-3 space-y-3 text-sm text-[var(--muted-foreground)]">
                {data.sources.map((source) => (
                  <li>
                    {source.url ? (
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-[var(--foreground)] underline underline-offset-4 decoration-[var(--border-primary)]"
                      >
                        {source.label}
                      </a>
                    ) : (
                      source.label
                    )}
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
