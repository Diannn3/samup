---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization } from '../data/organization';
import { membershipRules } from '../data/mission';
import { currentRecruitment, recruitmentLinks } from '../data/recruitment';
import { ArrowRight, ExternalLink, ShieldCheck, Landmark, Mail, CheckCircle2 } from 'lucide-react';
---

<BaseLayout
  title="Join SAM-UP | Society of Applied Mathematics of UPLB"
  description="Current source-aware recruitment guidance for students interested in joining the Society of Applied Mathematics of UPLB."
>
  <section class="relative overflow-hidden border-b border-[var(--border)] py-20 sm:py-24">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_75%_15%,rgba(240,204,78,0.12),transparent_35%)] pointer-events-none"
      aria-hidden="true"
    />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-4xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">
          Current recruitment guidance
        </p>
        <h1 class="mt-4 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight text-[var(--foreground)]">
          Join <span class="text-gold-gradient">SAM-UP</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          Start with what is verified now, then confirm the current application window and program-specific
          requirements through SAM-UP’s latest official announcement.
        </p>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-12">
    <section class="grid lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 frosted-glass-card p-7 sm:p-9">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <ShieldCheck class="w-4 h-4" aria-hidden="true" />
          <span>{currentRecruitment.term}</span>
        </div>
        <h2 class="mt-4 font-display font-bold text-2xl sm:text-4xl text-[var(--foreground)]">
          {currentRecruitment.statusLabel}
        </h2>
        <div class="mt-6 grid sm:grid-cols-2 gap-5">
          <div class="p-5 rounded-2xl border border-[var(--border)] bg-white/[0.03]">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
              Registration
            </div>
            <p class="mt-2 text-sm font-semibold text-[var(--foreground)]">
              Registered for {currentRecruitment.term}
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-[var(--border)] bg-white/[0.03]">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
              Current application scope
            </div>
            <p class="mt-2 text-sm font-semibold text-[var(--foreground)]">
              {currentRecruitment.applicationScope}
            </p>
          </div>
        </div>
        <p class="mt-6 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          {currentRecruitment.nextStep}
        </p>

        <div class="mt-7 flex flex-col sm:flex-row gap-3">
          <a
            href={recruitmentLinks.officialFacebook}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--primary)] px-6 py-3.5 text-sm font-bold text-[var(--primary-foreground)] hover:bg-[var(--primary-hover)] transition-colors"
          >
            Latest SAM-UP announcement
            <ArrowRight class="w-4 h-4" aria-hidden="true" />
          </a>
          <a
            href={recruitmentLinks.osaRecord}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface-raised)] px-6 py-3.5 text-sm font-semibold text-[var(--foreground)] hover:border-[var(--border-primary)] transition-colors"
          >
            Verify OSA record
            <ExternalLink class="w-4 h-4" aria-hidden="true" />
          </a>
        </div>
      </article>

      <aside class="lg:col-span-4 frosted-glass-card p-7 sm:p-8">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <CheckCircle2 class="w-4 h-4" aria-hidden="true" />
          <span>Before you apply</span>
        </div>
        <ol class="mt-5 space-y-5 text-sm text-[var(--muted-foreground)]">
          <li class="flex gap-3">
            <span class="font-mono text-[var(--primary)]">01</span>
            <span>Confirm that you fit the current OSA and SAM-UP eligibility guidance.</span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-[var(--primary)]">02</span>
            <span>Check whether recruitment is actually open in the latest SAM-UP announcement.</span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-[var(--primary)]">03</span>
            <span>Follow the current instructions rather than relying on an older application process.</span>
          </li>
        </ol>
      </aside>
    </section>

    <section class="grid lg:grid-cols-2 gap-8">
      <article class="frosted-glass-card p-7 sm:p-8">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <Landmark class="w-4 h-4" aria-hidden="true" />
          <span>Constitutional context</span>
        </div>
        <h2 class="mt-4 font-display font-bold text-2xl text-[var(--foreground)]">
          Membership classifications are not the same as today’s recruitment rules.
        </h2>
        <div class="mt-6 space-y-5">
          <div>
            <h3 class="text-sm font-semibold text-[var(--foreground)]">
              Resident Member — 2018 Constitution
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
              {membershipRules.resident}
            </p>
          </div>
          <div class="pt-5 border-t border-[var(--border-subtle)]">
            <h3 class="text-sm font-semibold text-[var(--foreground)]">
              Affiliate Member — 2018 Constitution
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
              {membershipRules.affiliate}
            </p>
          </div>
        </div>
      </article>

      <article class="frosted-glass-card p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono uppercase tracking-wider text-[var(--primary)]">Questions?</div>
          <h2 class="mt-4 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
            Ask the organization directly.
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)]">
            If a current announcement is unclear or your case is not covered by the public guidance, contact
            SAM-UP instead of guessing from historical rules.
          </p>
        </div>
        <a
          href={`mailto:${organization.socials.email}`}
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface-raised)] px-6 py-3.5 text-sm font-semibold text-[var(--foreground)] hover:border-[var(--border-primary)] transition-colors"
        >
          <Mail class="w-4 h-4 text-[var(--primary)]" aria-hidden="true" />
          {organization.socials.email}
        </a>
      </article>
    </section>
  </main>
</BaseLayout>
