---
import BaseLayout from '../layouts/BaseLayout.astro';
import { flagshipEvents, getEventLocationLabel } from '../data/events';
import { Calendar, Users, ArrowRight, MapPin, ShieldCheck, ExternalLink } from 'lucide-react';
---

<BaseLayout
  title="Programs & Updates | Society of Applied Mathematics of UPLB"
  description="Source-aware public program information and official update links from the Society of Applied Mathematics of UPLB."
>
  <section class="border-b border-[var(--border)] py-20 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">Programs & events</div>
        <h1 class="mt-5 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-[-0.035em] leading-[0.98] text-[var(--foreground)]">
          Current only when <span class="text-gold-gradient">verified.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          This directory distinguishes current public programs from historical or unverified records. Dates, venues, registration windows, and SAM-UP's role are not inferred from older repository content.
        </p>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-14">
    {flagshipEvents.length > 0 ? (
      <section class="divide-y divide-[var(--border)] border-y border-[var(--border)]" aria-label="Verified public programs">
        {flagshipEvents.map((event) => (
          <a
            href={event.ctaLink || '/events'}
            class="group grid lg:grid-cols-[13rem_1fr_auto] gap-5 lg:gap-8 py-7"
          >
            <div>
              <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--primary)]">{event.badge}</div>
              <div class="mt-2 text-xs text-[var(--muted-foreground)]">{event.category}</div>
            </div>
            <div>
              <h2 class="font-display font-bold text-2xl text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">{event.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">{event.description}</p>
              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-mono text-[var(--muted-foreground)]">
                <span class="inline-flex items-center gap-1.5"><Calendar class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />{event.schedule}</span>
                <span class="inline-flex items-center gap-1.5"><Users class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />{event.targetAudience}</span>
                <span class="inline-flex items-center gap-1.5"><MapPin class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />{getEventLocationLabel(event)}</span>
              </div>
            </div>
            <ArrowRight class="hidden lg:block w-5 h-5 text-[var(--muted-foreground)] group-hover:text-[var(--primary)] group-hover:translate-x-1 transition-all" aria-hidden="true" />
          </a>
        ))}
      </section>
    ) : (
      <section class="grid lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 rounded-[1.5rem] border border-[var(--border)] p-8 sm:p-10">
          <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
            <ShieldCheck class="w-4 h-4" aria-hidden="true" />
            <span>Verification in progress</span>
          </div>
          <h2 class="mt-4 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
            No legacy program is being labeled current just to make this page look full.
          </h2>
          <p class="mt-4 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
            Existing repository records are being checked for current ownership, SAM-UP's specific role, schedule, audience, and public status. Records remain quarantined until the evidence is publishable.
          </p>
        </div>

        <aside class="lg:col-span-5 border-t border-[var(--border)] pt-6">
          <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--muted-foreground)]">Need the latest schedule?</div>
          <h2 class="mt-3 font-display font-bold text-2xl text-[var(--foreground)]">Use the official announcement channel.</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)]">
            The website should not outrun the organization. Check SAM-UP's current public announcement for dates, venues, registration, and participation instructions.
          </p>
          <a
            href="https://facebook.com/SAMUPLB"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline"
          >
            Official SAM-UP page
            <ExternalLink class="w-4 h-4" aria-hidden="true" />
          </a>
        </aside>
      </section>
    )}
  </main>
</BaseLayout>
