---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ExecutiveSearch } from '../components/interactive/ExecutiveSearch';
import { organization } from '../data/organization';
import { FrostedGlassCard } from '../components/ui/FrostedGlassCard';
import { Award, GraduationCap, Mail, Landmark, Users } from 'lucide-react';
---

<BaseLayout
  title="Alumni & Leadership | Society of Applied Mathematics of UPLB"
  description={`Explore the historical roll of ${organization.totalLeadershipTerms} Senior Executives and distinguished alumni of SAM-UP since 1984.`}
>
  {/* Page Header with Ambient Gradient Mesh */}
  <section class="py-20 sm:py-24 border-b border-[var(--border)] relative overflow-hidden">
    <div class="glow-blob w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(240,204,78,0.12)_0%,transparent_70%)] top-0 left-[-10%]" aria-hidden="true" />
    <div class="glow-blob w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(59,130,246,0.09)_0%,transparent_70%)] bottom-0 right-[-10%]" aria-hidden="true" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="coord-badge">
          <Landmark class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
          <span>FOUR DECADES OF GOVERNANCE • 1984–PRESENT</span>
        </div>
        <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl text-[var(--foreground)] tracking-tight">
          Alumni & <span class="text-gold-gradient">Senior Executives</span>
        </h1>
        <p class="text-base sm:text-lg text-[var(--muted-foreground)] leading-relaxed font-normal">
          Celebrating the leaders, scholars, and trailblazers who have guided the Society of Applied Mathematics of UPLB across {organization.totalLeadershipTerms} consecutive terms of governance.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-24">
    {/* Junior Adviser Spotlight */}
    <section class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <div class="coord-badge">
          <span>FACULTY SPOTLIGHT</span>
        </div>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-[var(--foreground)] tracking-tight">
          Junior Adviser & Research Pioneer
        </h2>
      </div>

      <FrostedGlassCard
        client:idle
        tag="CENTENNIAL PROFESSORIAL CHAIR AWARDEE (AY 2024–2025)"
        title="Dr. Mark Lexter D. De Lara"
        subtitle="An esteemed alumnus of SAM-UP (Batch La Vita e Bella) and Assistant Professor at the Institute of Mathematical Sciences and Physics (IMSP). His pioneering research integrates operations research, topological data analysis (TDA), and computer vision models for Filipino Sign Language (FSL) recognition."
        showArrow={false}
      >
        <div class="grid lg:grid-cols-12 gap-8 items-center mt-6 pt-6 border-t border-[var(--border-subtle)]">
          <div class="lg:col-span-8 space-y-4">
            <div class="flex flex-wrap gap-2.5 text-xs font-mono text-[var(--muted-foreground)]">
              <span class="px-3 py-1 rounded-md bg-white/5 border border-white/10">
                Batch La Vita e Bella
              </span>
              <span class="px-3 py-1 rounded-md bg-white/5 border border-white/10">
                Junior Adviser
              </span>
              <span class="px-3 py-1 rounded-md bg-white/5 border border-white/10">
                UPLB IMSP Faculty
              </span>
            </div>
          </div>

          <div class="lg:col-span-4 flex flex-col items-center justify-center p-6 rounded-2xl bg-white/5 border border-white/10 text-center space-y-3 shadow-inner">
            <div class="w-14 h-14 rounded-2xl bg-[var(--primary)]/10 border border-[var(--primary)]/20 flex items-center justify-center text-[var(--primary)] shadow-sm">
              <GraduationCap class="w-7 h-7" aria-hidden="true" />
            </div>
            <div class="font-display font-bold text-base text-[var(--foreground)]">
              Academic Mentorship
            </div>
            <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
              Guiding resident members in advanced quantitative research, machine learning applications, and graduate study pathways.
            </p>
          </div>
        </div>
      </FrostedGlassCard>
    </section>

    {/* Searchable Roll of Senior Executives */}
    <section class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <div class="coord-badge">
          <span>ROLL OF HONOR • 1984–PRESENT</span>
        </div>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-[var(--foreground)] tracking-tight">
          Roll of Senior Executives
        </h2>
        <p class="text-base text-[var(--muted-foreground)]">
          Search all {organization.totalLeadershipTerms} leadership terms from Founding Senior Executive Edmund Campos (1984) to the present.
        </p>
      </div>

      <ExecutiveSearch client:load />
    </section>

    {/* Alumni Engagement & Networking Frosted Banner */}
    <section class="frosted-glass-card p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
      <div class="space-y-2 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-2 text-xs font-mono text-[var(--primary)]">
          <Users class="w-4 h-4" aria-hidden="true" />
          <span>ALUMNI RELATIONS</span>
        </div>
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
          Are you a SAM-UP Alumnus?
        </h3>
        <p class="text-sm text-[var(--muted-foreground)] max-w-xl">
          Reconnect with your batchmates, participate in the annual Alumni Homecoming, and mentor resident members preparing for research and industry careers.
        </p>
      </div>

      <a
        href={`mailto:${organization.socials.email}?subject=SAM-UP Alumni Reconnect`}
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-sm hover:bg-[var(--primary-hover)] transition-all shrink-0 shadow-md shadow-[var(--primary)]/20"
      >
        <Mail class="w-4 h-4" aria-hidden="true" />
        <span>Contact Alumni Relations</span>
      </a>
    </section>
  </div>
</BaseLayout>
