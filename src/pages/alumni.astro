---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ExecutiveSearch } from '../components/interactive/ExecutiveSearch';
import { organization } from '../data/organization';
import { Mail, Landmark, Users } from 'lucide-react';
---

<BaseLayout
  title="Leadership Archive | Society of Applied Mathematics of UPLB"
  description={`Search all ${organization.totalLeadershipTerms} documented leadership terms of SAM-UP, from 1984 to the current academic year.`}
>
  {/* Page Header */}
  <section class="py-20 sm:py-24 border-b border-[var(--border)] relative overflow-hidden">
    <div class="glow-blob w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(240,204,78,0.12)_0%,transparent_70%)] top-0 left-[-10%]" aria-hidden="true" />
    <div class="glow-blob w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(59,130,246,0.09)_0%,transparent_70%)] bottom-0 right-[-10%]" aria-hidden="true" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="coord-badge">
          <Landmark class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
          <span>DOCUMENTED LEADERSHIP TERMS • 1984–PRESENT</span>
        </div>
        <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl text-[var(--foreground)] tracking-tight">
          The <span class="text-gold-gradient">Leadership Archive</span>
        </h1>
        <p class="text-base sm:text-lg text-[var(--muted-foreground)] leading-relaxed font-normal">
          Search all {organization.totalLeadershipTerms} documented leadership terms of SAM-UP, from the first recorded Senior Executive in 1984 through the latest entry in the archive.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-16">
    {/* Searchable archive — data from senior_executives.json */}
    <section class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <div class="coord-badge">
          <span>SEARCHABLE ARCHIVE</span>
        </div>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-[var(--foreground)] tracking-tight">
          Roll of Senior Executives
        </h2>
        <p class="text-base text-[var(--muted-foreground)]">
          Each entry records one academic-semester term of governance. This is a historical archive, not the current Executive Committee roster.
        </p>
      </div>

      <ExecutiveSearch client:load />
    </section>

    {/* Alumni contact */}
    <section class="frosted-glass-card p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
      <div class="space-y-2 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-2 text-xs font-mono text-[var(--primary)]">
          <Users class="w-4 h-4" aria-hidden="true" />
          <span>ALUMNI RELATIONS</span>
        </div>
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
          Are you a SAM-UP alumnus?
        </h3>
        <p class="text-sm text-[var(--muted-foreground)] max-w-xl">
          Reach out to reconnect with the organization. The archive grows as past terms are documented.
        </p>
      </div>

      <a
        href={`mailto:${organization.socials.email}?subject=SAM-UP Alumni Reconnect`}
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-sm hover:bg-[var(--primary-hover)] transition-all shrink-0 shadow-md shadow-[var(--primary)]/20"
      >
        <Mail class="w-4 h-4" aria-hidden="true" />
        <span>Contact SAM-UP</span>
      </a>
    </section>
  </div>
</BaseLayout>
