---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ExecutiveSearch } from '../components/interactive/ExecutiveSearch';
import { organization } from '../data/organization';
import { Archive, ArrowRight, ShieldCheck } from 'lucide-react';
---

<BaseLayout
  title="Leadership Archive | Society of Applied Mathematics of UPLB"
  description={`Search ${organization.totalLeadershipTerms} documented Senior Executive term entries in SAM-UP's historical repository archive.`}
>
  <section class="border-b border-[var(--border)] py-20 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">
          <Archive class="w-4 h-4" aria-hidden="true" />
          <span>Historical leadership records</span>
        </div>
        <h1 class="mt-5 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-[-0.035em] leading-[0.98] text-[var(--foreground)]">
          Leadership <span class="text-gold-gradient">Archive</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          Search {organization.totalLeadershipTerms} documented Senior Executive term entries beginning in
          1984. This is a historical dataset—not a representation of SAM-UP's complete current Executive
          Committee.
        </p>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-12">
    <section class="grid lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-4">
        <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--primary)]">Dataset scope</div>
        <dl class="mt-5 divide-y divide-[var(--border)] border-y border-[var(--border)]">
          <div class="py-5">
            <dt class="text-xs text-[var(--muted-foreground)]">Recorded entries</dt>
            <dd class="mt-1 font-display font-black text-3xl text-[var(--foreground)]">
              {organization.totalLeadershipTerms}
            </dd>
          </div>
          <div class="py-5">
            <dt class="text-xs text-[var(--muted-foreground)]">First archive entry</dt>
            <dd class="mt-1 text-sm font-semibold text-[var(--foreground)]">Edmund Campos • 2nd Sem 84–85</dd>
          </div>
          <div class="py-5">
            <dt class="text-xs text-[var(--muted-foreground)]">Latest repository entry</dt>
            <dd class="mt-1 text-sm font-semibold text-[var(--foreground)]">
              {organization.latestRecordedExecutive.name} • {organization.latestRecordedExecutive.term}
            </dd>
          </div>
        </dl>

        <div class="mt-6 flex items-start gap-3 text-xs leading-relaxed text-[var(--muted-foreground)]">
          <ShieldCheck class="w-4 h-4 shrink-0 mt-0.5 text-[var(--primary)]" aria-hidden="true" />
          <p>
            Gaps or the final entry in this dataset should not be used to infer missing historical terms or
            the present officer roster.
          </p>
        </div>
      </div>

      <div class="lg:col-span-8">
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
          Search documented terms
        </h2>
        <p class="mt-2 text-sm text-[var(--muted-foreground)]">
          Search by Senior Executive name or term label.
        </p>
        <div class="mt-6">
          <ExecutiveSearch client:load />
        </div>
      </div>
    </section>

    <section class="border-t border-[var(--border)] pt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
      <div>
        <h2 class="font-display font-bold text-2xl text-[var(--foreground)]">
          Looking for broader organizational history?
        </h2>
        <p class="mt-2 text-sm text-[var(--muted-foreground)]">
          The Archive hub separates leadership records from approved publication history.
        </p>
      </div>
      <a
        href="/archive"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline shrink-0"
      >
        Open Archive hub
        <ArrowRight class="w-4 h-4" aria-hidden="true" />
      </a>
    </section>
  </main>
</BaseLayout>
