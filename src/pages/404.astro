---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FrostedGlassCard } from '../components/ui/FrostedGlassCard';
import { Magnet } from '../ui/Magnet';
import { ArrowLeft, Compass } from 'lucide-react';
---

<BaseLayout
  title="404 — Coordinate Undefined | SAM-UP"
  description="The requested page coordinate does not exist in our topological space."
>
  <div class="min-h-[75vh] flex items-center justify-center px-4 py-20 text-center relative overflow-hidden">
    <div class="glow-blob w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(240,204,78,0.12)_0%,transparent_70%)] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true" />

    <div class="max-w-lg w-full relative z-10">
      <FrostedGlassCard client:load showArrow={false} className="p-8 sm:p-12 text-center shadow-2xl">
        <div class="w-16 h-16 rounded-2xl bg-[var(--primary)]/10 border border-[var(--primary)]/20 mx-auto flex items-center justify-center text-[var(--primary)] shadow-xl mb-6">
          <Compass class="w-8 h-8" aria-hidden="true" />
        </div>

        <div class="space-y-3 mb-8">
          <div class="coord-badge mx-auto">
            <span>ERROR 404 • TOPOLOGY BOUNDARY</span>
          </div>
          <h1 class="font-display font-black text-4xl sm:text-5xl text-[var(--foreground)] tracking-tight">
            Coordinate Undefined
          </h1>
          <p class="text-sm text-[var(--muted-foreground)] leading-relaxed max-w-sm mx-auto">
            The requested route <span class="font-mono text-[var(--primary)]">{Astro.url.pathname}</span> lies outside the defined manifold of this platform.
          </p>
        </div>

        <Magnet client:load strength={12}>
          <a
            href="/"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-sm hover:bg-[var(--primary-hover)] transition-all shadow-md shadow-[var(--primary)]/20"
          >
            <ArrowLeft class="w-4 h-4" aria-hidden="true" />
            <span>Return to Origin</span>
          </a>
        </Magnet>
      </FrostedGlassCard>
    </div>
  </div>
</BaseLayout>
