---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import { BookOpen, ArrowRight } from 'lucide-react';
---

<BaseLayout
  title="Academic Resources | Society of Applied Mathematics of UPLB"
  description="Course coverage of SAM-UP's peer tutorial caravans: Calculus, Linear Algebra, Differential Equations, and Optimization."
>
  {/* Page Header */}
  <section class="py-20 sm:py-24 border-b border-[var(--border)] relative overflow-hidden">
    <div class="glow-blob w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(240,204,78,0.12)_0%,transparent_70%)] top-0 left-[-10%]" aria-hidden="true" />
    <div class="glow-blob w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(16,185,129,0.09)_0%,transparent_70%)] bottom-0 right-[-10%]" aria-hidden="true" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl text-[var(--foreground)] tracking-tight">
          Academic <span class="text-gold-gradient">Resources</span>
        </h1>
        <p class="font-mono text-xs uppercase tracking-widest text-[var(--primary)]/90">
          PEER TUTORIAL CARAVANS // UPLB.IMSP
        </p>
        <p class="text-base sm:text-lg text-[var(--muted-foreground)] leading-relaxed font-normal">
          SAM-UP's peer tutorial caravans cover foundational mathematics courses at UPLB. Sessions run each semester — see Events & Programs for the current schedule.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-16">
    {/* Course coverage — sourced from events.ts tutorial descriptions */}
    <section class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <h2 class="font-display font-black text-3xl sm:text-4xl text-[var(--foreground)] tracking-tight">
          Peer Tutorial Caravan Syllabus
        </h2>
        <p class="font-mono text-xs uppercase tracking-widest text-[var(--primary)]/90">
          COURSE COVERAGE // FOUNDATIONAL MATHEMATICS UPLB
        </p>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
        <GlassCard tag="CALCULUS" title="Math 27 / 28" subtitle="Limits, derivatives, integration techniques, multivariable calculus, and vector analysis." showArrow={false} />
        <GlassCard tag="ALGEBRA" title="Math 110" subtitle="Vector spaces, matrix decompositions, eigenvalues, linear transformations, and inner products." showArrow={false} />
        <GlassCard tag="DIFFERENTIAL" title="Math 180" subtitle="First-order ODEs, higher-order linear systems, Laplace transforms, and boundary value problems." showArrow={false} />
        <GlassCard tag="OPTIMIZATION" title="Math 165" subtitle="Linear programming, Simplex algorithm, duality theory, transportation, and network optimization." showArrow={false} />
      </div>
    </section>

    {/* Schedule pointer — the verified update channel */}
    <section class="frosted-glass-card p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-2 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-2 text-xs font-mono text-[var(--primary)]">
          <BookOpen class="w-4 h-4" aria-hidden="true" />
          <span>TUTORIAL SCHEDULES</span>
        </div>
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
          When are the next sessions?
        </h3>
        <p class="text-sm text-[var(--muted-foreground)] max-w-xl">
          Tutorial caravan schedules are announced each semester on the official SAM-UP Facebook page and posted on the Events & Programs page.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a
          href="/events"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-sm hover:bg-[var(--primary-hover)] transition-all shadow-md shadow-[var(--primary)]/20"
        >
          <span>View Events & Programs</span>
          <ArrowRight class="w-4 h-4" aria-hidden="true" />
        </a>
        <a
          href="https://facebook.com/SAMUPLB"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--surface-raised)] border border-[var(--border)] text-[var(--foreground)] font-semibold text-sm hover:border-[var(--border-primary)] transition-all shadow-sm"
        >
          <span>Follow @SAMUPLB</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
