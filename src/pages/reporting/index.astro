---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../styles/global.css';
import '../../styles/monochrome-spatial.css';
import { WorldContainer } from '../../components/reporting/WorldContainer';
import { STATIONS } from '../../data/reporting/stations';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>SAM-UP Applicant Reporting // Aedrian "Dian" Ponce</title>
    <meta
      name="description"
      content="A monochrome spatial reporting and applicant conversation experience for the Society of Applied Mathematics of UPLB (SAM-UP)."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </head>
  <body class="bg-[#fafafa] text-neutral-900 antialiased overflow-hidden m-0 p-0">
    <header class="sr-only">
      <h1>SAM-UP Applicant Reporting — Aedrian "Dian" Ponce</h1>
      <p>Marketing Deputy Head (Promotions), Society of Applied Mathematics of UPLB</p>
    </header>

    <nav aria-label="Stations" class="sr-only">
      <ol>
        {STATIONS.map((station) => (
          <li>
            <h2>
              [{station.index}] {station.title}
            </h2>
            <p>{station.subtitle}</p>
            <p>{station.description}</p>
          </li>
        ))}
      </ol>
    </nav>

    <main class="w-screen h-screen">
      <WorldContainer client:only="react" />
    </main>
  </body>
</html>
