---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Landmark, ShieldCheck, FileText } from 'lucide-react';

const documents = (
  await getCollection(
    'governance',
    ({ data }) =>
      (data.evidence.visibility === 'public' || data.evidence.visibility === 'public-summary-only') &&
      data.evidence.status !== 'unknown' &&
      data.evidence.status !== 'blocked' &&
      data.evidence.status !== 'needs-approval',
  )
).sort((a, b) => {
  const rank = { constitution: 0, bylaws: 1, policy: 2, 'public-guidance': 3 } as const;
  return rank[a.data.documentType] - rank[b.data.documentType];
});
---

<BaseLayout
  title="Governance | Society of Applied Mathematics of UPLB"
  description="Public-safe summaries of the foundational and current governance documents used to ground SAM-UP's institutional website."
>
  <section class="relative overflow-hidden border-b border-[var(--border)] py-20 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">
          <Landmark class="w-4 h-4" aria-hidden="true" />
          <span>Governance & source integrity</span>
        </div>
        <h1 class="mt-5 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-[-0.035em] leading-[0.98] text-[var(--foreground)]">
          Know what the site is <span class="text-gold-gradient">grounded in.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          SAM-UP's website separates foundational rules, current operational guidance, historical records, and
          time-sensitive announcements. These summaries show which documents ground the public institutional
          claims without automatically exposing internal procedures.
        </p>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-14">
    <section class="grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <ShieldCheck class="w-4 h-4" aria-hidden="true" />
          <span>Reading rule</span>
        </div>
        <h2 class="mt-4 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
          Foundational does not always mean current.
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-[var(--muted-foreground)]">
          The Constitution defines enduring identity and governance foundations. Current recruitment,
          schedules, officers, and public procedures require newer evidence when newer official guidance
          exists.
        </p>
      </div>

      <div class="lg:col-span-8 divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {documents.map((document) => (
          <a
            href={`/governance/${document.data.slug}`}
            class="group grid sm:grid-cols-[10rem_1fr_auto] gap-4 sm:gap-6 items-start py-7"
          >
            <div>
              <span class="inline-flex rounded-full border border-[var(--border)] px-3 py-1 text-[10px] font-mono uppercase tracking-wider text-[var(--primary)]">
                {document.data.documentType}
              </span>
              <div class="mt-2 text-xs font-mono text-[var(--muted-foreground)]">
                {document.data.versionLabel}
              </div>
            </div>
            <div>
              <h3 class="font-display font-bold text-xl text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">
                {document.data.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
                {document.data.summary}
              </p>
              <div class="mt-3 text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
                Reviewed {document.data.evidence.reviewedAt} • {document.data.evidence.visibility}
              </div>
            </div>
            <ArrowRight
              class="hidden sm:block mt-1 w-5 h-5 text-[var(--muted-foreground)] group-hover:text-[var(--primary)] group-hover:translate-x-1 transition-all"
              aria-hidden="true"
            />
          </a>
        ))}
      </div>
    </section>

    <section class="rounded-[1.5rem] border border-[var(--border)] p-7 sm:p-9">
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 shrink-0 rounded-xl border border-[var(--border-primary)] bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)]">
          <FileText class="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="max-w-3xl">
          <h2 class="font-display font-bold text-2xl text-[var(--foreground)]">
            Why summaries instead of a raw document dump?
          </h2>
          <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
            Governance files can contain operational details that are unnecessary or inappropriate for a
            public website. Public summaries preserve institutional transparency while respecting internal
            procedures, privacy, and approval boundaries.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
