---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Newspaper, ShieldCheck } from 'lucide-react';

const issues = (await getCollection('chronicle', ({ data }) =>
  (data.evidence.visibility === 'public' || data.evidence.visibility === 'historical') &&
  data.evidence.status !== 'unknown' &&
  data.evidence.status !== 'blocked' &&
  data.evidence.status !== 'needs-approval'
)).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
---

<BaseLayout
  title="The Chronicle | SAM-UP"
  description="Public archive for approved issues and articles of The Chronicle, SAM-UP's organizational newsletter."
>
  <section class="border-b border-[var(--border)] py-20 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">
          <Newspaper class="w-4 h-4" aria-hidden="true" />
          <span>Organizational publication archive</span>
        </div>
        <h1 class="mt-5 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-[-0.035em] leading-[0.98] text-[var(--foreground)]">
          The <span class="text-gold-gradient">Chronicle</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
          The A.Y. 2026–2027 Bylaws identify The Chronicle as SAM-UP's newsletter. This public archive only displays issues or articles after their public status and source record are verified.
        </p>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    {issues.length > 0 ? (
      <section class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {issues.map((issue) => (
          <a href={issue.data.sourceUrl ?? '#'} class="group grid sm:grid-cols-[9rem_1fr_auto] gap-5 py-7">
            <div class="font-mono text-xs text-[var(--muted-foreground)]">{issue.data.publishedAt}</div>
            <div>
              <h2 class="font-display font-bold text-xl text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">{issue.data.title}</h2>
              <p class="mt-2 text-sm text-[var(--muted-foreground)]">{issue.data.summary}</p>
              <p class="mt-2 text-xs font-mono text-[var(--muted-foreground)]">By {issue.data.author}</p>
            </div>
            <ArrowRight class="hidden sm:block w-5 h-5 text-[var(--muted-foreground)] group-hover:text-[var(--primary)]" aria-hidden="true" />
          </a>
        ))}
      </section>
    ) : (
      <section class="max-w-4xl rounded-[1.5rem] border border-[var(--border)] p-8 sm:p-10">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <ShieldCheck class="w-4 h-4" aria-hidden="true" />
          <span>Archive ingestion pending</span>
        </div>
        <h2 class="mt-4 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
          No issue is being invented just to fill the page.
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          Approved Chronicle issues will appear here after the source file, publication date, author/editor information, and public visibility are verified. Until then, this route remains an explicit empty archive.
        </p>
      </section>
    )}
  </main>
</BaseLayout>
