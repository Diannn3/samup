---
interface Props {
  title: string;
  category: string;
  formula: string;
  description: string;
  icon: string;
  accentColor?: string;
  tag: string;
}

const {
  title,
  category,
  formula,
  description,
  icon,
  accentColor = "gold",
  tag
} = Astro.props;
---

<div class="glass-panel glass-panel-hover rounded-3xl p-8 border border-[#D4AF37]/15 flex flex-col justify-between relative group overflow-hidden">
  <!-- KeyShot Ambient Glow Spot -->
  <div class="absolute -top-12 -right-12 w-40 h-40 bg-[#D4AF37]/10 rounded-full blur-2xl group-hover:bg-[#D4AF37]/20 transition-[background-color] duration-500"></div>

  <div>
    <!-- Header with Tag and Icon -->
    <div class="flex items-center justify-between mb-6">
      <span class="text-xs font-mono px-3 py-1 rounded-full bg-slate-900/90 text-[#F5D77F] border border-[#D4AF37]/30 tracking-wider">
        {tag}
      </span>
      <span class="text-3xl p-3 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-inner group-hover:scale-110 transition-transform duration-300">
        {icon}
      </span>
    </div>

    <!-- Category & Title -->
    <div class="mb-4">
      <span class="text-xs font-mono text-slate-400 uppercase tracking-widest block mb-1">{category}</span>
      <h3 class="text-2xl font-display font-bold text-slate-100 group-hover:text-[#F5D77F] transition-colors">
        {title}
      </h3>
    </div>

    <!-- Mathematical Formula / Blueprint Display -->
    <div class="my-4 p-3.5 rounded-xl bg-[#080B10] border border-slate-800/80 font-mono text-xs text-[#E6C656] flex items-center justify-between overflow-x-auto shadow-inner">
      <span class="text-slate-400 font-sans text-[11px]">KERNEL:</span>
      <code class="font-semibold tracking-wide">{formula}</code>
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-300 leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Bottom Interactive Accent -->
  <div class="mt-8 pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs font-mono text-slate-400">
    <span class="flex items-center gap-1.5 text-slate-400 group-hover:text-[#F5D77F] transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37]"></span>
      IMSP Research Node
    </span>
    <span class="text-slate-500 group-hover:translate-x-1 transition-transform">Explore Models →</span>
  </div>
</div>
