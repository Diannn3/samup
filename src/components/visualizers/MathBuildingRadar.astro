---
// MathBuildingRadar.astro - Interactive UPLB Math Building Academic Hub Radar Visualizer
---

<div class="glass-panel rounded-3xl p-8 lg:p-12 border border-[#D4AF37]/20 shadow-2xl relative overflow-hidden">
  <div class="flex flex-col lg:flex-row gap-10 items-center">
    <!-- Radar Visualization Canvas (Left) -->
    <div class="w-full lg:w-1/2 flex flex-col items-center justify-center relative">
      <div class="relative w-72 h-72 sm:w-80 sm:h-80 flex items-center justify-center">
        <!-- Radar Sweep SVG -->
        <svg class="w-full h-full relative z-10" viewBox="0 0 360 360" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="radarSweep" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(212, 175, 55, 0.4)" />
              <stop offset="70%" stop-color="rgba(212, 175, 55, 0.05)" />
              <stop offset="100%" stop-color="transparent" />
            </radialGradient>
          </defs>

          <!-- Concentric Distance Grids -->
          <circle cx="180" cy="180" r="160" stroke="#D4AF37" stroke-width="1" stroke-dasharray="4 8" opacity="0.3" />
          <circle cx="180" cy="180" r="120" stroke="#D4AF37" stroke-width="1" opacity="0.2" />
          <circle cx="180" cy="180" r="80" stroke="#D4AF37" stroke-width="1" opacity="0.25" />
          <circle cx="180" cy="180" r="40" stroke="#D4AF37" stroke-width="1.5" stroke-dasharray="2 4" opacity="0.4" />

          <!-- Crosshairs -->
          <line x1="20" y1="180" x2="340" y2="180" stroke="#D4AF37" stroke-width="1" opacity="0.2" />
          <line x1="180" y1="20" x2="180" y2="340" stroke="#D4AF37" stroke-width="1" opacity="0.2" />

          <!-- Math Building Nodes -->
          <!-- Node 1: IMSP Admin & Faculty -->
          <circle cx="180" cy="80" r="8" fill="#F5D77F" class="animate-ping opacity-75" />
          <circle cx="180" cy="80" r="6" fill="#D4AF37" stroke="#FFF6D1" stroke-width="2" />
          <text x="195" y="85" fill="#F5D77F" font-size="10" font-family="monospace" font-weight="bold">IMSP CAS FACULTY</text>

          <!-- Node 2: SAM-UP Tambayan & Academic HQ -->
          <circle cx="250" cy="190" r="10" fill="#E6C656" class="animate-pulse" />
          <circle cx="250" cy="190" r="7" fill="#F5D77F" stroke="#0B0E14" stroke-width="2" />
          <text x="160" y="220" fill="#FFF6D1" font-size="11" font-family="monospace" font-weight="bold">★ SAM-UP TAMBAYAN</text>

          <!-- Node 3: Computational Math Labs -->
          <circle cx="110" cy="230" r="6" fill="#8EA7E9" stroke="#FFF" stroke-width="1.5" />
          <text x="35" y="250" fill="#8EA7E9" font-size="10" font-family="monospace">COMPUTATIONAL LAB</text>

          <!-- Node 4: Math Wizard Lecture Hall -->
          <circle cx="120" cy="120" r="6" fill="#D4AF37" stroke="#FFF" stroke-width="1.5" />
          <text x="50" y="115" fill="#D4AF37" font-size="10" font-family="monospace">LECTURE HALL W-1</text>
        </svg>

        <!-- Dynamic Rotating Radar Sweep Line -->
        <div class="absolute inset-0 rounded-full border border-[#D4AF37]/20 pointer-events-none animate-spin [animation-duration:8s]">
          <div class="w-1/2 h-1/2 bg-gradient-to-br from-[#D4AF37]/25 to-transparent rounded-tl-full origin-bottom-right"></div>
        </div>
      </div>
      <div class="mt-4 font-mono text-xs text-slate-400">
        LAT 14.1675° N, LON 121.2433° E • UPLB MATH BUILDING
      </div>
    </div>

    <!-- Hub Features & Services (Right) -->
    <div class="w-full lg:w-1/2 flex flex-col gap-4">
      <div>
        <span class="text-xs font-mono text-[#D4AF37] tracking-widest uppercase block mb-1">Academic Infrastructure</span>
        <h3 class="text-2xl sm:text-3xl font-display font-bold text-slate-100 mb-3">
          The Math Building Academic Hub
        </h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          The physical and digital epicenter of applied mathematics at UPLB. Integrating indoor navigation, faculty knowledge directories, and peer tutorial networks.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-3 mt-2">
        <div class="p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-base mb-1">🗺️</div>
          <h4 class="text-sm font-bold text-slate-200">Semantic Indoor Navigation</h4>
          <p class="text-xs text-slate-400 mt-1">Client-side A* pathfinding for classrooms, faculty offices, and testing halls.</p>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-base mb-1">📚</div>
          <h4 class="text-sm font-bold text-slate-200">Course & Faculty Matrix</h4>
          <p class="text-xs text-slate-400 mt-1">Comprehensive directory for Applied Math major courses (Math 180, 181, 182, 190).</p>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-base mb-1">🤝</div>
          <h4 class="text-sm font-bold text-slate-200">Peer Tutoring Network</h4>
          <p class="text-xs text-slate-400 mt-1">Scholastics committee free tutorial sessions for foundational calculus & linear algebra.</p>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-base mb-1">🏆</div>
          <h4 class="text-sm font-bold text-slate-200">Math Wizard Arena</h4>
          <p class="text-xs text-slate-400 mt-1">Flagship regional inter-high school and collegiate academic competition hub.</p>
        </div>
      </div>
    </div>
  </div>
</div>
