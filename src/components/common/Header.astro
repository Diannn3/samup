---
import { organization } from '../../data/organization';
import { MobileNav } from '../interactive/MobileNav';
import { Magnet } from '../ui/Magnet';

const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About & Heritage', href: '/about' },
  { label: 'Events & Programs', href: '/events' },
  { label: 'Alumni & Leadership', href: '/alumni' },
  { label: 'Academic Hub', href: '/resources' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 w-full backdrop-blur-2xl bg-[var(--background)]/60 border-b border-[var(--border)] transition-colors">
  {/* Specular top highlight */}
  <div class="absolute top-0 inset-x-0 h-[1px] bg-gradient-to-r from-transparent via-[var(--primary)]/30 to-transparent" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    {/* Logo & Identity */}
    <a href="/" class="flex items-center gap-3 group focus-visible:outline-none" aria-label="SAM-UP Home">
      <div class="w-10 h-10 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] flex items-center justify-center font-display font-black text-xl shadow-lg shadow-[var(--primary)]/20 group-hover:scale-105 transition-transform">
        Π
      </div>
      <div class="flex flex-col">
        <span class="font-display font-bold text-base tracking-wider text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">
          SAM-UP
        </span>
        <span class="text-[10px] font-mono text-[var(--muted-foreground)] tracking-widest uppercase">
          Applied Math • UPLB
        </span>
      </div>
    </a>

    {/* Desktop Navigation with Frosted Glass Pill */}
    <nav class="hidden md:flex items-center gap-1.5 p-1.5 rounded-full bg-[var(--surface)]/80 backdrop-blur-xl border border-[var(--border)] shadow-inner" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all ${
            isActive(item.href)
              ? 'bg-[var(--surface-raised)] text-[var(--primary)] shadow-sm border border-[var(--border-primary)]/40'
              : 'text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:bg-white/5'
          }`}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    {/* CTA Button with Magnet Effect */}
    <div class="hidden md:flex items-center gap-3">
      <Magnet client:idle strength={12}>
        <a
          href="/#membership"
          class="px-5 py-2.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-xs hover:bg-[var(--primary-hover)] transition-all shadow-md shadow-[var(--primary)]/20"
        >
          Join SAM-UP
        </a>
      </Magnet>
    </div>

    {/* Mobile Navigation Island */}
    <div class="md:hidden">
      <MobileNav client:load currentPath={currentPath} />
    </div>
  </div>
</header>
