---
import { organization } from '../../data/organization';
import { mainNav } from '../../data/navigation';
---

<footer class="relative bg-[var(--background)]/80 backdrop-blur-2xl border-t border-[var(--border)] pt-16 pb-12 text-[var(--muted-foreground)] overflow-hidden">
  {/* Ambient gradient backing */}
  <div class="glow-blob w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(240,204,78,0.06)_0%,transparent_70%)] top-0 left-1/2 -translate-x-1/2" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid md:grid-cols-12 gap-10 pb-12 border-b border-[var(--border)]">
      {/* Col 1: Organization Identity */}
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] flex items-center justify-center font-display font-black text-xl shadow-md">
            Π
          </div>
          <span class="font-display font-bold text-lg text-[var(--foreground)] tracking-wide">
            {organization.name}
          </span>
        </div>
        <p class="text-sm leading-relaxed max-w-sm text-[var(--muted-foreground)]">
          {organization.tagline}. A self-governing academic student organization of applied mathematics at the University of the Philippines Los Baños since 1984.
        </p>
        <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs text-[var(--primary)]">
          {organization.mottos.map(m => (
            <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10">
              {m.tag}
            </span>
          ))}
        </div>
      </div>

      {/* Col 2: Institutional Navigation */}
      <div class="md:col-span-3 space-y-3">
        <h4 class="font-display font-bold text-sm text-[var(--foreground)] uppercase tracking-wider">
          Explore SAM-UP
        </h4>
        <ul class="space-y-2 text-sm list-none p-0 m-0">
          {mainNav.map(item => (
            <li>
              <a href={item.href} class="hover:text-[var(--primary)] transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Col 3: Academic Affiliation & Location */}
      <div class="md:col-span-4 space-y-3 text-sm">
        <h4 class="font-display font-bold text-sm text-[var(--foreground)] uppercase tracking-wider">
          Campus Headquarters
        </h4>
        <address class="not-italic space-y-1.5 leading-relaxed">
          <div class="font-semibold text-[var(--foreground)]">{organization.department}</div>
          <div>{organization.college}</div>
          <div>{organization.institution}</div>
          <div class="text-xs font-mono text-[var(--muted-foreground)] pt-1">
            {organization.location.building} • {organization.location.coordinates}
          </div>
        </address>
        <div class="pt-2">
          <a
            href={organization.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--primary)] hover:underline"
          >
            Official Facebook Page →
          </a>
        </div>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <div>
        © 1984–{new Date().getFullYear()} {organization.name}. All rights reserved.
      </div>
      <div class="font-mono text-[var(--muted-foreground)]">
        Official Colors: Black & Gold • Est. Nov 27, 1984
      </div>
    </div>
  </div>
</footer>
