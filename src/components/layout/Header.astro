---
import { mainNav, membershipAction } from '../../data/navigation';
import { MobileNav } from '../interactive/MobileNav';
import { Magnet } from '../ui/Magnet';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="fixed top-0 inset-x-0 z-40 bg-[var(--background)]/65 backdrop-blur-2xl border-b border-[var(--border)] transition-colors">
  {/* Specular top highlight */}
  <div class="absolute top-0 inset-x-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      {/* Brand Identity */}
      <a href="/" class="flex items-center gap-3 group focus-visible:outline-none">
        <div class="w-10 h-10 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] flex items-center justify-center font-display font-black text-xl shadow-lg shadow-[var(--primary)]/20 group-hover:scale-105 transition-transform">
          Π
        </div>
        <div class="flex flex-col">
          <span class="font-display font-bold text-base sm:text-lg tracking-wide text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors leading-tight">
            SAM-UP
          </span>
          <span class="text-[10px] font-mono uppercase text-[var(--muted-foreground)] tracking-wider">
            Applied Math • UPLB
          </span>
        </div>
      </a>

      {/* Desktop Navigation in Frosted Glass Pill */}
      <nav class="hidden lg:flex items-center gap-1.5 p-1.5 rounded-full bg-white/5 backdrop-blur-xl border border-white/10 shadow-inner" aria-label="Primary Navigation">
        {mainNav.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all ${
                isActive
                  ? 'bg-white/15 text-[var(--primary)] shadow-sm border border-[var(--border-primary)]/50'
                  : 'text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:bg-white/5'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      {/* Primary Action & Mobile Menu Trigger */}
      <div class="flex items-center gap-3">
        <div class="hidden sm:inline-flex">
          <Magnet client:idle strength={12}>
            <a
              href={membershipAction.href}
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-xs hover:bg-[var(--primary-hover)] transition-all shadow-md shadow-[var(--primary)]/20"
            >
              {membershipAction.label}
            </a>
          </Magnet>
        </div>

        {/* Mobile Navigation Island */}
        <MobileNav client:load currentPath={currentPath} />
      </div>
    </div>
  </div>
</header>
