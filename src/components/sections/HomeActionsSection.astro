---
import { ArrowRight, Handshake, Users, ShieldCheck } from 'lucide-react';
---

<section class="relative py-20 sm:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-px rounded-[1.75rem] overflow-hidden border border-[var(--border)] bg-[var(--border)]">
      <article class="bg-[var(--background)] p-8 sm:p-10 lg:p-12">
        <div class="w-11 h-11 rounded-xl border border-[var(--border-primary)] bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)]">
          <Users className="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="mt-8 font-mono text-xs uppercase tracking-wider text-[var(--primary)]">
          For prospective members
        </div>
        <h2 class="mt-3 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          Join with current information.
        </h2>
        <p class="mt-4 max-w-xl text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          The Join page separates present OSA guidance from older constitutional membership classifications
          and points to the latest official recruitment announcement.
        </p>
        <a
          href="/join"
          class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-[var(--primary)] hover:underline"
        >
          Current recruitment guidance
          <ArrowRight className="w-4 h-4" aria-hidden="true" />
        </a>
      </article>

      <article class="bg-[var(--background)] p-8 sm:p-10 lg:p-12">
        <div class="w-11 h-11 rounded-xl border border-[var(--border-primary)] bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)]">
          <Handshake className="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="mt-8 font-mono text-xs uppercase tracking-wider text-[var(--primary)]">
          For organizations & sponsors
        </div>
        <h2 class="mt-3 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          Collaborate around real value.
        </h2>
        <p class="mt-4 max-w-xl text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          Start with a problem, audience, or opportunity. The public Partners page explains collaboration
          paths without publishing internal rates, draft obligations, or unapproved promises.
        </p>
        <a
          href="/partners"
          class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-[var(--primary)] hover:underline"
        >
          Partnership information
          <ArrowRight className="w-4 h-4" aria-hidden="true" />
        </a>
      </article>
    </div>

    <div class="mt-6 flex items-start gap-3 text-xs leading-relaxed text-[var(--muted-foreground)]">
      <ShieldCheck className="w-4 h-4 text-[var(--primary)] shrink-0 mt-0.5" aria-hidden="true" />
      <p>
        Both paths are source-aware: current application and partnership claims are not inferred from
        historical or internal-only documents.
      </p>
    </div>
  </div>
</section>
