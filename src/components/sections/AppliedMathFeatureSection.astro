---
import { getCollection } from 'astro:content';
import ShortestPathDiagram from '../math/ShortestPathDiagram.astro';
import { ArrowRight, Sigma } from 'lucide-react';

const articles = (
  await getCollection(
    'appliedMath',
    ({ data }) =>
      data.evidence.visibility === 'public' &&
      data.evidence.status !== 'unknown' &&
      data.evidence.status !== 'blocked' &&
      data.evidence.status !== 'needs-approval',
  )
).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

const featured = articles[0];
---

{featured && (
  <section class="relative py-20 sm:py-24 border-b border-[var(--border)] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-5">
          <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
            <Sigma class="w-4 h-4" aria-hidden="true" />
            <span>Applied Math, explained</span>
          </div>
          <h2 class="mt-4 font-display font-black text-3xl sm:text-5xl tracking-tight text-[var(--foreground)]">
            Not “math content.” A model you can actually reason with.
          </h2>
          <p class="mt-5 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
            SAM-UP's Promotions mandate includes educational and promotional content that advances the
            appreciation and understanding of mathematics. The website turns that into a repeatable explainer
            series.
          </p>

          <div class="mt-8 pt-6 border-t border-[var(--border)]">
            <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--muted-foreground)]">
              Featured • {featured.data.level}
            </div>
            <h3 class="mt-2 font-display font-bold text-2xl text-[var(--foreground)]">
              {featured.data.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)]">{featured.data.summary}</p>
            <a
              href={`/explore/${featured.data.slug}`}
              class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline"
            >
              Open explainer
              <ArrowRight class="w-4 h-4" aria-hidden="true" />
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          {featured.data.slug === 'shortest-paths' ? (
            <ShortestPathDiagram compact />
          ) : (
            <div class="aspect-[4/3] rounded-[1.5rem] border border-[var(--border)] bg-[var(--surface)] flex items-center justify-center">
              <Sigma class="w-16 h-16 text-[var(--primary)]" aria-hidden="true" />
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
)}
