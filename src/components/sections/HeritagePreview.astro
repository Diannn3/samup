---
import { milestones } from '../../data/milestones';
import { ArrowRight, Landmark } from 'lucide-react';
---

<section class="relative py-20 sm:py-24 border-b border-[var(--border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <Landmark class="w-4 h-4" aria-hidden="true" />
          <span>Documented history</span>
        </div>
        <h2 class="mt-4 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          A short timeline with clear evidence.
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          The redesign avoids padding SAM-UP's history with unsourced prestige claims. These milestones come from the Constitution and the documented leadership archive.
        </p>
        <a href="/about" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline">
          About SAM-UP
          <ArrowRight class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>

      <div class="lg:col-span-8 divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {milestones.map((milestone) => (
          <article class="grid sm:grid-cols-[6rem_1fr] gap-4 sm:gap-7 py-6">
            <div class="font-mono text-sm text-[var(--primary)]">{milestone.year}</div>
            <div>
              <h3 class="font-display font-bold text-xl text-[var(--foreground)]">{milestone.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">{milestone.description}</p>
              <p class="mt-2 text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">{milestone.source}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
