---
import { activities } from '../../data/activities';
import { ArrowUpRight } from 'lucide-react';

const getTag = (id: string) => {
  switch (id) {
    case 'math-wizard': return 'FLAGSHIP TOURNAMENT';
    case 'tutorials': return 'ACADEMIC SERVICE';
    case 'caravan': return 'OUTREACH & CLINICS';
    default: return 'COLLEGIATE BROTHERHOOD';
  }
};
---

<section id="initiatives" class="relative py-24 lg:py-32 border-b border-[var(--border)] overflow-hidden">
  {/* Atmospheric Background Gradient Blobs */}
  <div class="glow-blob w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(240,204,78,0.12)_0%,transparent_70%)] top-10 left-[-10%]" aria-hidden="true" />
  <div class="glow-blob w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(16,185,129,0.1)_0%,transparent_70%)] bottom-10 right-[-10%]" aria-hidden="true" />
  <div class="glow-blob w-[400px] h-[400px] bg-[radial-gradient(circle,rgba(59,130,246,0.08)_0%,transparent_70%)] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Section Header */}
    <div class="max-w-3xl mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--surface-raised)] border border-[var(--border)] text-xs font-mono text-[var(--primary)] shadow-sm">
        <span>CORE INITIATIVES & IMPACT</span>
      </div>
      <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-[var(--foreground)] tracking-tight">
        Institutional Programs & Competitions
      </h2>
      <p class="text-[var(--muted-foreground)] text-base sm:text-lg leading-relaxed">
        From our flagship national mathematical tournaments to grassroots peer tutorial caravans, SAM-UP advances mathematical culture across UPLB and Southern Tagalog.
      </p>
    </div>

    {/* Static Astro card grid — no hydration */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {activities.map((activity) => (
        <a href="/events" class="block no-underline focus-visible:outline-none group">
          <div class="frosted-glass-card p-6 sm:p-7 flex flex-col justify-between h-full">
            <div class="relative z-10 w-full">
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-[11px] font-mono font-bold tracking-widest uppercase text-[var(--primary)] px-2.5 py-0.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20">
                  {getTag(activity.id)}
                </span>
                <ArrowUpRight
                  class="w-5 h-5 text-[var(--muted-foreground)] group-hover:text-[var(--primary)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all ml-auto shrink-0"
                  aria-hidden="true"
                />
              </div>
              <h3 class="font-display font-bold text-xl sm:text-2xl text-[var(--foreground)] group-hover:text-white transition-colors tracking-tight leading-snug">
                {activity.title}
              </h3>
              <p class="text-sm text-[var(--foreground)]/80 mt-2 leading-relaxed font-normal">
                {activity.description}
              </p>
              <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-mono text-[var(--muted-foreground)]">
                <span class="text-[var(--foreground)] font-semibold">{activity.metrics || 'Annual Flagship'}</span>
                <span class="text-[var(--primary)] font-medium">Explore Event Syllabus →</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
