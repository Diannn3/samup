---
import { principles, objectives, emblem } from '../../data/mission';
import { ArrowRight, Scale, Sigma } from 'lucide-react';
---

<section id="mission" class="relative py-20 sm:py-24 border-b border-[var(--border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <Sigma class="w-4 h-4" aria-hidden="true" />
          <span>Constitution • Articles III–IV</span>
        </div>
        <h2 class="mt-4 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          What SAM-UP is organized to do.
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          The Constitution defines principles and objectives. The website keeps those categories intact rather
          than inventing a separate corporate mission-and-vision system.
        </p>
        <a
          href="/governance/constitution-2018"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline"
        >
          Constitution summary
          <ArrowRight class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>

      <div class="lg:col-span-8">
        <div class="grid md:grid-cols-5 gap-8">
          <div class="md:col-span-3">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--primary)]">
              Article IV • Objectives
            </div>
            <ol class="mt-5 divide-y divide-[var(--border)] border-y border-[var(--border)]">
              {objectives.map((objective, index) => (
                <li class="grid grid-cols-[2.75rem_1fr] gap-3 py-4">
                  <span class="font-mono text-xs text-[var(--primary)]">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="text-sm leading-relaxed text-[var(--foreground)]/90">
                    {objective.text.charAt(0).toUpperCase() + objective.text.slice(1)}
                  </span>
                </li>
              ))}
            </ol>
          </div>

          <div class="md:col-span-2">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--primary)]">
              Article III • Principles
            </div>
            <ul class="mt-5 space-y-5">
              {principles.map((principle) => (
                <li class="flex items-start gap-3">
                  <Scale class="w-4 h-4 text-[var(--primary)] shrink-0 mt-0.5" aria-hidden="true" />
                  <span class="text-sm leading-relaxed text-[var(--muted-foreground)]">{principle.text}</span>
                </li>
              ))}
            </ul>

            <div class="mt-7 pt-5 border-t border-[var(--border)]">
              <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
                The piu
              </div>
              <p class="mt-2 text-xs leading-relaxed text-[var(--muted-foreground)]">{emblem.piu}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
