---
import MathBuildingRadar from '../visualizers/MathBuildingRadar.astro';
import MeritCalculator from '../visualizers/MeritCalculator.astro';
---

<section id="hub" class="py-20 lg:py-32 bg-[#090C12] border-t border-b border-slate-800/80 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D4AF37]/10 text-[#F5D77F] font-mono text-xs mb-4 border border-[#D4AF37]/30">
        UPLB IMSP • Academic Hub & Student Infrastructure
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-bold text-slate-100 mb-6">
        Math Building <span class="gold-gradient-text">Academic Hub</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
        A unified platform connecting student navigation, faculty directories, academic tutorials, and constitutional governance.
      </p>
    </div>

    <!-- Math Building Radar Component -->
    <div class="mb-20">
      <MathBuildingRadar />
    </div>

    <!-- Merit & Dues Calculator Component -->
    <div>
      <MeritCalculator />
    </div>
  </div>
</section>
