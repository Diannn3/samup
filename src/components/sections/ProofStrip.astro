---
import { organization } from '../../data/organization';
import { Sparkles, Compass, ShieldCheck, Award } from 'lucide-react';
---

<section class="relative py-8 border-b border-[var(--border)] bg-[var(--background)]/40 backdrop-blur-md overflow-hidden">
  {/* Ambient gradient ribbon */}
  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[var(--primary)]/5 to-transparent pointer-events-none" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {/* 1. Academic Home */}
      <div class="frosted-glass-card p-4 sm:p-5 flex items-center gap-3.5 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-[var(--primary)]/10 border border-[var(--primary)]/20 flex items-center justify-center text-[var(--primary)] shrink-0">
          <Compass class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <div class="text-[10px] font-mono text-[var(--muted-foreground)] uppercase tracking-wider">ACADEMIC HOME</div>
          <div class="font-display font-bold text-sm text-[var(--foreground)] mt-0.5">UPLB IMSP • CAS</div>
        </div>
      </div>

      {/* 2. Foundation Epoch */}
      <div class="frosted-glass-card p-4 sm:p-5 flex items-center gap-3.5 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-[var(--primary)]/10 border border-[var(--primary)]/20 flex items-center justify-center text-[var(--primary)] shrink-0">
          <ShieldCheck class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <div class="text-[10px] font-mono text-[var(--muted-foreground)] uppercase tracking-wider">FOUNDING EPOCH</div>
          <div class="font-display font-bold text-sm text-[var(--foreground)] mt-0.5">Nov 27, 1984</div>
        </div>
      </div>

      {/* 3. Executive Terms */}
      <div class="frosted-glass-card p-4 sm:p-5 flex items-center gap-3.5 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-[var(--primary)]/10 border border-[var(--primary)]/20 flex items-center justify-center text-[var(--primary)] shrink-0">
          <Award class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <div class="text-[10px] font-mono text-[var(--muted-foreground)] uppercase tracking-wider">LEADERSHIP</div>
          <div class="font-display font-bold text-sm text-[var(--foreground)] mt-0.5">46 Senior Execs</div>
        </div>
      </div>

      {/* 4. Alumni Network */}
      <div class="frosted-glass-card p-4 sm:p-5 flex items-center gap-3.5 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-[var(--primary)]/10 border border-[var(--primary)]/20 flex items-center justify-center text-[var(--primary)] shrink-0">
          <Sparkles class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <div class="text-[10px] font-mono text-[var(--muted-foreground)] uppercase tracking-wider">GLOBAL ALUMNI</div>
          <div class="font-display font-bold text-sm text-[var(--foreground)] mt-0.5">500+ Scholars</div>
        </div>
      </div>
    </div>
  </div>
</section>
