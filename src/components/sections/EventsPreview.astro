---
import { flagshipEvents, getEventLocationLabel } from '../../data/events';
import GlassCard from '../ui/GlassCard.astro';
import { Trophy, ArrowRight, Calendar, Users, MapPin } from 'lucide-react';
---

<section class="relative py-24 border-b border-[var(--border)] overflow-hidden">
  {/* Atmospheric mesh gradient backing */}
  <div class="glow-blob w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(240,204,78,0.08)_0%,transparent_70%)] top-0 right-[-10%]" aria-hidden="true" />
  <div class="glow-blob w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(16,185,129,0.07)_0%,transparent_70%)] bottom-0 left-[-10%]" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="max-w-2xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--surface)] border border-[var(--border)] text-xs font-mono text-[var(--primary)]">
          <Trophy class="w-3.5 h-3.5" aria-hidden="true" />
          <span>EVENTS & PROGRAMS</span>
        </div>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-[var(--foreground)] tracking-tight">
          Current Initiatives & Programs
        </h2>
        <p class="text-[var(--muted-foreground)] text-sm sm:text-base">
          Competitions, tutorial caravans, and athletics organized by SAM-UP.
        </p>
      </div>

      <a
        href="/events"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline shrink-0"
      >
        <span>View All Events & Programs</span>
        <ArrowRight class="w-4 h-4" aria-hidden="true" />
      </a>
    </div>

    {/* Canonical event data from src/data/events.ts — no duplication */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {flagshipEvents.map((event) => (
        <GlassCard
          tag={event.badge}
          title={event.title}
          subtitle={event.description}
          href={event.ctaLink || '/events'}
          showArrow={true}
        >
          <div class="space-y-3 pt-3 mt-3 border-t border-[var(--border-subtle)]">
            <div class="flex items-center gap-2 text-xs font-mono text-[var(--foreground)]/80">
              <Calendar class="w-3.5 h-3.5 text-[var(--primary)] shrink-0" aria-hidden="true" />
              <span>{event.schedule}</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-[var(--foreground)]/80">
              <Users class="w-3.5 h-3.5 text-[var(--primary)] shrink-0" aria-hidden="true" />
              <span>{event.targetAudience}</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-[var(--muted-foreground)]">
              <MapPin class="w-3.5 h-3.5 text-[var(--primary)] shrink-0" aria-hidden="true" />
              <span>{getEventLocationLabel(event)}</span>
            </div>
          </div>
        </GlassCard>
      ))}
    </div>
  </div>
</section>
