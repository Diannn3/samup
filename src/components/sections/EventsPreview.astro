---
import { getCollection } from 'astro:content';
import { ArrowRight, Calendar, MapPin, ShieldCheck, Users } from 'lucide-react';

const programs = (
  await getCollection(
    'programs',
    ({ data }) =>
      data.evidence.visibility === 'public' &&
      data.evidence.status !== 'unknown' &&
      data.evidence.status !== 'blocked' &&
      data.evidence.status !== 'needs-approval' &&
      data.lifecycle !== 'historical' &&
      data.lifecycle !== 'cancelled',
  )
).slice(0, 3);

const getScheduleLabel = (program: (typeof programs)[number]) =>
  program.data.startDate ?? program.data.recurringLabel ?? 'See current source';
---

<section class="relative py-20 sm:py-24 border-b border-[var(--border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--primary)]">Programs & events</div>
        <h2 class="mt-4 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          Current means source-backed.
        </h2>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          A recurring activity is not automatically a currently scheduled activity. The site publishes program
          records only after organizer, SAM-UP role, and current status are verified.
        </p>
      </div>

      <a
        href="/programs"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline shrink-0"
      >
        Programs & official updates
        <ArrowRight className="w-4 h-4" aria-hidden="true" />
      </a>
    </div>

    {programs.length > 0 ? (
      <div class="mt-10 divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {programs.map((program) => (
          <article class="grid lg:grid-cols-[12rem_1fr] gap-5 lg:gap-8 items-start py-7">
            <div>
              <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--primary)]">
                {program.data.lifecycle}
              </div>
              <div class="mt-2 text-xs text-[var(--muted-foreground)]">{program.data.organizer}</div>
            </div>
            <div>
              <h3 class="font-display font-bold text-xl text-[var(--foreground)]">{program.data.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
                {program.data.summary}
              </p>
              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-mono text-[var(--muted-foreground)]">
                <span class="inline-flex items-center gap-1.5">
                  <Calendar className="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
                  {getScheduleLabel(program)}
                </span>
                {program.data.audience && (
                  <span class="inline-flex items-center gap-1.5">
                    <Users className="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
                    {program.data.audience}
                  </span>
                )}
                {program.data.location && (
                  <span class="inline-flex items-center gap-1.5">
                    <MapPin className="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
                    {program.data.location}
                  </span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-10 rounded-[1.5rem] border border-[var(--border)] p-7 sm:p-8 flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-[var(--primary)]/10 border border-[var(--border-primary)] flex items-center justify-center text-[var(--primary)] shrink-0">
          <ShieldCheck className="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="max-w-2xl">
          <h3 class="font-display font-bold text-xl text-[var(--foreground)]">
            Current program records are being verified.
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
            Legacy program names stay outside the public collection until their ownership, SAM-UP role, and
            status are source-backed.
          </p>
        </div>
      </div>
    )}
  </div>
</section>
