---
import { flagshipEvents, getEventLocationLabel } from '../../data/events';
import { ArrowRight, Calendar, MapPin, ShieldCheck, Users } from 'lucide-react';
---

<section class="relative py-20 sm:py-24 border-b border-[var(--border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--primary)]">Programs & events</div>
        <h2 class="mt-4 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          Current means source-backed.
        </h2>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          A recurring activity is not automatically a currently scheduled activity. The site publishes program cards only after the current status is verified.
        </p>
      </div>

      <a href="/events" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline shrink-0">
        Programs & official updates
        <ArrowRight class="w-4 h-4" aria-hidden="true" />
      </a>
    </div>

    {flagshipEvents.length > 0 ? (
      <div class="mt-10 divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {flagshipEvents.map((event) => (
          <a
            href={event.ctaLink || '/events'}
            class="group grid lg:grid-cols-[12rem_1fr_auto] gap-5 lg:gap-8 items-start py-7"
          >
            <div>
              <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--primary)]">{event.badge}</div>
              <div class="mt-2 text-xs text-[var(--muted-foreground)]">{event.category}</div>
            </div>
            <div>
              <h3 class="font-display font-bold text-xl text-[var(--foreground)] group-hover:text-[var(--primary)] transition-colors">{event.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">{event.description}</p>
              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-mono text-[var(--muted-foreground)]">
                <span class="inline-flex items-center gap-1.5"><Calendar class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />{event.schedule}</span>
                <span class="inline-flex items-center gap-1.5"><Users class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />{event.targetAudience}</span>
                <span class="inline-flex items-center gap-1.5"><MapPin class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />{getEventLocationLabel(event)}</span>
              </div>
            </div>
            <ArrowRight class="hidden lg:block w-5 h-5 text-[var(--muted-foreground)] group-hover:text-[var(--primary)] group-hover:translate-x-1 transition-all" aria-hidden="true" />
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-10 rounded-[1.5rem] border border-[var(--border)] p-7 sm:p-8 flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-[var(--primary)]/10 border border-[var(--border-primary)] flex items-center justify-center text-[var(--primary)] shrink-0">
          <ShieldCheck class="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="max-w-2xl">
          <h3 class="font-display font-bold text-xl text-[var(--foreground)]">Current program records are being verified.</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">
            Legacy program names remain quarantined from public listings until their current ownership, role, and status are confirmed. The Programs page links to SAM-UP's official update channel in the meantime.
          </p>
        </div>
      </div>
    )}
  </div>
</section>
