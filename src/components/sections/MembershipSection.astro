---
import { organization } from '../../data/organization';
import { membershipRules } from '../../data/mission';
import { Magnet } from '../ui/Magnet';
import { CheckCircle2, ArrowRight, Sparkles, Mail } from 'lucide-react';
---

<section id="membership" class="relative py-24 lg:py-32 border-b border-[var(--border)] overflow-hidden">
  {/* Ambient gradient blobs */}
  <div class="glow-blob w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(240,204,78,0.12)_0%,transparent_70%)] top-10 left-1/3" aria-hidden="true" />
  <div class="glow-blob w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(16,185,129,0.09)_0%,transparent_70%)] bottom-10 right-10" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--surface-raised)] border border-[var(--border)] text-xs font-mono text-[var(--primary)] shadow-sm">
        <Sparkles class="w-3.5 h-3.5" aria-hidden="true" />
        <span>JOIN THE SOCIETY</span>
      </div>
      <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-[var(--foreground)] tracking-tight">
        Membership & Recruitment Pathways
      </h2>
      <p class="text-[var(--muted-foreground)] text-base sm:text-lg leading-relaxed">
        Membership is governed by Article VII of the SAM-UP Constitution. Two pathways are open to UPLB students.
      </p>
    </div>

    {/* Membership Cards — static Astro cards; React reserved for the primary CTA Magnet */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {/* Resident Member Track — primary pathway, Magnet CTA */}
      <div class="frosted-glass-card p-6 sm:p-7 flex flex-col justify-between">
        <div class="relative z-10 w-full">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-[11px] font-mono font-bold tracking-widest uppercase text-[var(--primary)] px-2.5 py-0.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20">
              PRIMARY PATHWAY
            </span>
          </div>
          <h3 class="font-display font-bold text-xl sm:text-2xl text-[var(--foreground)] tracking-tight leading-snug">
            Resident Member
          </h3>
          <p class="text-sm text-[var(--foreground)]/80 mt-2 leading-relaxed font-normal">
            For BS Applied Mathematics students. {membershipRules.resident}
          </p>

          <div class="mt-4">
            <ul class="space-y-2.5 text-xs text-[var(--foreground)]/85 pt-2">
              <li class="flex items-start gap-2">
                <CheckCircle2 class="w-4 h-4 text-[var(--primary)] shrink-0 mt-0.5" aria-hidden="true" />
                <span>Full constitutional voting rights and executive eligibility</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle2 class="w-4 h-4 text-[var(--primary)] shrink-0 mt-0.5" aria-hidden="true" />
                <span>Active participation in standing committees</span>
              </li>
            </ul>

            <div class="pt-6 mt-4 border-t border-[var(--border-subtle)]">
              <Magnet client:idle strength={12} className="w-full">
                <a
                  href={organization.socials.facebook}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-sm hover:bg-[var(--primary-hover)] transition-all shadow-md"
                >
                  <span>Express Interest via Facebook</span>
                  <ArrowRight class="w-4 h-4" aria-hidden="true" />
                </a>
              </Magnet>
              <p class="text-[11px] text-[var(--muted-foreground)] mt-3 leading-relaxed font-mono">
                Recruitment details are announced each semester on the official page.
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* Affiliate Member Track — static card, plain anchor CTA */}
      <div class="frosted-glass-card p-6 sm:p-7 flex flex-col justify-between">
        <div class="relative z-10 w-full">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-[11px] font-mono font-bold tracking-widest uppercase text-[var(--primary)] px-2.5 py-0.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20">
              CROSS-DISCIPLINARY
            </span>
          </div>
          <h3 class="font-display font-bold text-xl sm:text-2xl text-[var(--foreground)] tracking-tight leading-snug">
            Affiliate Member
          </h3>
          <p class="text-sm text-[var(--foreground)]/80 mt-2 leading-relaxed font-normal">
            For students outside BS Applied Mathematics. {membershipRules.affiliate}
          </p>

          <div class="mt-4">
            <ul class="space-y-2.5 text-xs text-[var(--foreground)]/85 pt-2">
              <li class="flex items-start gap-2">
                <CheckCircle2 class="w-4 h-4 text-[var(--primary)] shrink-0 mt-0.5" aria-hidden="true" />
                <span>Participation in committees, events, and initiatives</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle2 class="w-4 h-4 text-[var(--primary)] shrink-0 mt-0.5" aria-hidden="true" />
                <span>Converts to Resident Member upon shifting to BS Applied Mathematics</span>
              </li>
            </ul>

            <div class="pt-6 mt-4 border-t border-[var(--border-subtle)]">
              <a
                href={`mailto:${organization.socials.email}`}
                class="inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-xl bg-[var(--surface-raised)] border border-[var(--border)] text-[var(--foreground)] font-semibold text-sm hover:border-[var(--border-primary)] transition-all shadow-sm"
              >
                <span>Email the Organization</span>
                <ArrowRight class="w-4 h-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Contact strip — verified channels */}
    <div class="max-w-5xl mx-auto mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 text-xs font-mono text-[var(--muted-foreground)]">
      <span class="flex items-center gap-1.5">
        <span class="text-[var(--primary)]" aria-hidden="true">FB</span>
        <a href={organization.socials.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--foreground)] transition-colors">facebook.com/SAMUPLB</a>
      </span>
      <span aria-hidden="true">•</span>
      <span class="flex items-center gap-1.5">
        <Mail class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
        <a href={`mailto:${organization.socials.email}`} class="hover:text-[var(--foreground)] transition-colors">samup.uplb@gmail.com</a>
      </span>
    </div>
  </div>
</section>
