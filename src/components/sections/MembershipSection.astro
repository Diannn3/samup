---
import { organization } from '../../data/organization';
import { membershipRules } from '../../data/mission';
import { currentRecruitment, recruitmentLinks } from '../../data/recruitment';
import { ArrowRight, Sparkles, Mail, ShieldCheck, Landmark, ExternalLink } from 'lucide-react';
---

<section id="membership" class="relative py-24 lg:py-32 border-b border-[var(--border)] overflow-hidden">
  <div class="glow-blob w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(240,204,78,0.12)_0%,transparent_70%)] top-10 left-1/3" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--surface-raised)] border border-[var(--border)] text-xs font-mono text-[var(--primary)] shadow-sm">
        <Sparkles class="w-3.5 h-3.5" aria-hidden="true" />
        <span>JOIN SAM-UP</span>
      </div>
      <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-[var(--foreground)] tracking-tight">
        Current recruitment guidance
      </h2>
      <p class="text-[var(--muted-foreground)] text-base sm:text-lg leading-relaxed">
        Constitutional membership categories and current application eligibility are different layers. This section uses current UPLB OSA guidance for the public application scope, then points applicants to SAM-UP's latest announcement for the actual application window and specific conditions.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-6xl mx-auto">
      <article class="lg:col-span-7 frosted-glass-card p-6 sm:p-8">
        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 text-[11px] font-mono font-bold tracking-widest uppercase text-[var(--primary)]">
            <ShieldCheck class="w-4 h-4" aria-hidden="true" />
            <span>{currentRecruitment.term}</span>
          </div>

          <h3 class="mt-4 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)] tracking-tight">
            {currentRecruitment.statusLabel}
          </h3>

          <div class="mt-5 space-y-4 text-sm text-[var(--foreground)]/85 leading-relaxed">
            <p>
              <strong class="text-[var(--foreground)]">Current OSA application scope:</strong>{' '}
              {currentRecruitment.applicationScope}
            </p>
            <p>{currentRecruitment.nextStep}</p>
          </div>

          <div class="mt-6 p-4 rounded-xl border border-[var(--border)] bg-white/[0.03]">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
              SOURCE
            </div>
            <div class="mt-1 text-sm font-semibold text-[var(--foreground)]">
              {currentRecruitment.evidence.sourceLabel}
            </div>
            <p class="mt-1 text-xs text-[var(--muted-foreground)] leading-relaxed">
              Reviewed {currentRecruitment.evidence.reviewedAt}. This source confirms the CAS-only scope; it does not by itself mean recruitment is open today.
            </p>
          </div>

          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a
              href={recruitmentLinks.officialFacebook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-sm hover:bg-[var(--primary-hover)] transition-all shadow-md"
            >
              <span>Check latest SAM-UP announcement</span>
              <ArrowRight class="w-4 h-4" aria-hidden="true" />
            </a>
            <a
              href={recruitmentLinks.osaRecord}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--surface-raised)] border border-[var(--border)] text-[var(--foreground)] font-semibold text-sm hover:border-[var(--border-primary)] transition-all"
            >
              <span>Verify OSA record</span>
              <ExternalLink class="w-4 h-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </article>

      <article class="lg:col-span-5 frosted-glass-card p-6 sm:p-8">
        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 text-[11px] font-mono font-bold tracking-widest uppercase text-[var(--primary)]">
            <Landmark class="w-4 h-4" aria-hidden="true" />
            <span>CONSTITUTIONAL DEFINITIONS</span>
          </div>

          <h3 class="mt-4 font-display font-bold text-xl sm:text-2xl text-[var(--foreground)]">
            Governance context, not a live application form
          </h3>

          <div class="mt-5 space-y-5">
            <div>
              <div class="text-xs font-mono text-[var(--primary)]">RESIDENT MEMBER — 2018 CONSTITUTION</div>
              <p class="mt-2 text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed">
                {membershipRules.resident}
              </p>
            </div>
            <div class="pt-5 border-t border-[var(--border-subtle)]">
              <div class="text-xs font-mono text-[var(--primary)]">AFFILIATE MEMBER — 2018 CONSTITUTION</div>
              <p class="mt-2 text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed">
                {membershipRules.affiliate}
              </p>
            </div>
          </div>

          <p class="mt-5 text-xs text-[var(--muted-foreground)] leading-relaxed">
            These clauses explain constitutional member classifications. Current recruitment may apply additional present-day restrictions and procedures, so they should not be read as a guarantee of current eligibility.
          </p>
        </div>
      </article>
    </div>

    <div class="max-w-5xl mx-auto mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 text-xs font-mono text-[var(--muted-foreground)]">
      <span class="flex items-center gap-1.5">
        <span class="text-[var(--primary)]" aria-hidden="true">FB</span>
        <a href={organization.socials.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--foreground)] transition-colors">facebook.com/SAMUPLB</a>
      </span>
      <span aria-hidden="true">•</span>
      <span class="flex items-center gap-1.5">
        <Mail class="w-3.5 h-3.5 text-[var(--primary)]" aria-hidden="true" />
        <a href={`mailto:${organization.socials.email}`} class="hover:text-[var(--foreground)] transition-colors">{organization.socials.email}</a>
      </span>
    </div>
  </div>
</section>
