---
import MathDisciplineCard from '../visualizers/MathDisciplineCard.astro';
---

<section id="disciplines" class="py-20 lg:py-32 bg-[#07090D] relative overflow-hidden math-grid-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D4AF37]/10 text-[#F5D77F] font-mono text-xs mb-4 border border-[#D4AF37]/30">
        Quantitative Frontier • IMSP UPLB
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-bold text-slate-100 mb-6">
        Applied Mathematics <span class="gold-gradient-text">Disciplines</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
        Where abstract mathematical structures are deployed into high-dimensional algorithms, optimization engines, and real-world technological solutions.
      </p>
    </div>

    <!-- Research Spotlight Card (Dr. Mark Lexter De Lara) -->
    <div class="glass-panel rounded-3xl p-8 lg:p-10 border border-[#D4AF37]/30 shadow-2xl mb-16 relative overflow-hidden">
      <div class="flex flex-col lg:flex-row gap-8 items-center">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-br from-[#D4AF37] to-[#8A6600] flex items-center justify-center text-4xl shadow-xl shadow-[#D4AF37]/20 flex-shrink-0">
          🎓
        </div>
        <div class="flex-grow">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="text-xs font-mono text-slate-400 bg-slate-900 px-2.5 py-1 rounded-md border border-slate-800">
              ADVISORY & ALUMNI SPOTLIGHT
            </span>
            <span class="text-xs font-mono text-[#F5D77F] bg-[#D4AF37]/10 px-2.5 py-1 rounded-md border border-[#D4AF37]/30">
              Batch La Vita e Bella
            </span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-display font-bold text-slate-100 mb-2">
            Dr. Mark Lexter D. De Lara
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light">
            Junior Adviser and recipient of the prestigious <strong>UPLB Centennial Professorial Chair Lecture Award (AY 2024–2025)</strong>. Pioneering research bridging discrete optimization, topological data analysis (TDA), and machine learning applications including Filipino Sign Language (FSL) Alphabet Recognition.
          </p>
        </div>
        <div class="flex-shrink-0">
          <div class="px-5 py-2.5 rounded-full bg-slate-900 border border-[#D4AF37]/40 text-xs font-mono text-[#F5D77F]">
            #SAMUPSpotlight
          </div>
        </div>
      </div>
    </div>

    <!-- Grid of Discipline Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <MathDisciplineCard
        title="Operations Research"
        category="Optimization & Graph Theory"
        formula="min f(x) s.t. g_i(x) ≤ 0, h_j(x) = 0"
        description="Linear and nonlinear programming, mixed-integer optimization, network flow routing, and supply-chain logistics powering enterprise efficiency."
        icon="📊"
        tag="IMSP-OR-01"
      />

      <MathDisciplineCard
        title="Topological Data Analysis"
        category="High-Dimensional Geometry"
        formula="H_k(K) = \ker(\partial_k) / \text{im}(\partial_{k+1})"
        description="Extracting persistent geometric and topological features from complex point cloud data across manifold learning and neural latent spaces."
        icon="🧬"
        tag="IMSP-TDA-02"
      />

      <MathDisciplineCard
        title="Applied Machine Learning"
        category="AI & Sign Language Recognition"
        formula="\mathcal{L}(\theta) = \mathbb{E}[-\log P_\theta(y \mid x)]"
        description="Computer vision, sign language translation, convex loss optimization, and neural representations empowering accessible communication."
        icon="🤖"
        tag="IMSP-ML-03"
      />

      <MathDisciplineCard
        title="Financial Mathematics"
        category="Stochastic Calculus & Risk"
        formula="dS_t = \mu S_t dt + \sigma S_t dW_t"
        description="Black-Scholes modeling, Martingale measures, algorithmic trading strategy optimization, and actuarial portfolio risk hedging."
        icon="📈"
        tag="IMSP-FIN-04"
      />

      <MathDisciplineCard
        title="Biomathematics"
        category="Epidemiology & Systems"
        formula="\frac{dS}{dt} = -\beta SI, \quad \frac{dI}{dt} = \beta SI - \gamma I"
        description="Nonlinear dynamical systems, compartmental infectious disease modeling, and ecological population stability analysis for public health."
        icon="🦠"
        tag="IMSP-BIO-05"
      />

      <MathDisciplineCard
        title="Discrete Mathematics"
        category="Combinatorics & Cryptography"
        formula="e \cdot d \equiv 1 \pmod{\phi(n)}"
        description="Elliptic curve cryptography, algebraic graph theory, combinatorics, and discrete structures forming the bedrock of secure distributed computing."
        icon="🔐"
        tag="IMSP-CRY-06"
      />
    </div>
  </div>
</section>
