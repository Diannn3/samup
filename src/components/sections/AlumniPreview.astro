---
import { organization } from '../../data/organization';
import { ArrowRight, Archive } from 'lucide-react';
---

<section class="relative py-20 sm:py-24 border-b border-[var(--border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <Archive className="w-4 h-4" aria-hidden="true" />
          <span>Leadership archive</span>
        </div>
        <h2 class="mt-4 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          Historical leadership, labeled as history.
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          The repository contains {organization.totalLeadershipTerms} documented Senior Executive term entries
          beginning in 1984. They form a historical archive, not a current Executive Committee roster.
        </p>

        <div class="mt-7 grid grid-cols-2 border-y border-[var(--border)]">
          <div class="py-5 pr-5">
            <div class="font-display font-black text-3xl text-[var(--primary)]">
              {organization.totalLeadershipTerms}
            </div>
            <div class="mt-1 text-xs text-[var(--muted-foreground)]">Documented term entries</div>
          </div>
          <div class="py-5 pl-5 border-l border-[var(--border)]">
            <div class="font-display font-black text-3xl text-[var(--foreground)]">1984</div>
            <div class="mt-1 text-xs text-[var(--muted-foreground)]">Archive begins</div>
          </div>
        </div>

        <a
          href="/alumni"
          class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline"
        >
          Search leadership records
          <ArrowRight className="w-4 h-4" aria-hidden="true" />
        </a>
      </div>

      <article class="lg:col-span-7 rounded-[1.5rem] border border-[var(--border)] p-7 sm:p-9">
        <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--muted-foreground)]">
          Latest entry in the repository archive
        </div>
        <div class="mt-2 font-mono text-xs text-[var(--primary)]">
          {organization.latestRecordedExecutive.term}
        </div>
        <h3 class="mt-4 font-display font-black text-3xl sm:text-4xl text-[var(--foreground)]">
          {organization.latestRecordedExecutive.name}
        </h3>
        <p class="mt-4 max-w-2xl text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          Recorded as Senior Executive for {organization.latestRecordedExecutive.term}. “Latest archive entry”
          means the last item in the available historical dataset; it should not be generalized into claims
          about the complete current officer roster.
        </p>
        <div class="mt-7 pt-5 border-t border-[var(--border)] flex flex-wrap gap-x-6 gap-y-2 text-[10px] font-mono uppercase tracking-wider text-[var(--muted-foreground)]">
          <span>
            Entry {organization.totalLeadershipTerms} of {organization.totalLeadershipTerms}
          </span>
          <span>Dataset: senior_executives.json</span>
        </div>
      </article>
    </div>
  </div>
</section>
