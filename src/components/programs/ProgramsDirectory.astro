---
import { getCollection } from 'astro:content';
import { Calendar, Users, ArrowRight, MapPin, ShieldCheck, ExternalLink } from 'lucide-react';

const programs = (
  await getCollection(
    'programs',
    ({ data }) =>
      (data.evidence.visibility === 'public' || data.evidence.visibility === 'historical') &&
      data.evidence.status !== 'unknown' &&
      data.evidence.status !== 'blocked' &&
      data.evidence.status !== 'needs-approval',
  )
).sort((a, b) => {
  const aDate = a.data.startDate ?? '';
  const bDate = b.data.startDate ?? '';
  return bDate.localeCompare(aDate);
});

const getScheduleLabel = (program: (typeof programs)[number]) =>
  program.data.startDate ??
  program.data.recurringLabel ??
  (program.data.lifecycle === 'historical' ? 'Historical record' : 'See current source');
---

<section class="border-b border-[var(--border)] py-20 sm:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <div class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--primary)]">Programs & events</div>
      <h1 class="mt-5 font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-[-0.035em] leading-[0.98] text-[var(--foreground)]">
        Current only when <span class="text-gold-gradient">verified.</span>
      </h1>
      <p class="mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[var(--muted-foreground)]">
        This directory distinguishes current public programs from historical or unverified records. Dates,
        venues, registration windows, organizers, and SAM-UP's role are not inferred from older repository
        content.
      </p>
    </div>
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-14">
  {programs.length > 0 ? (
    <section
      class="divide-y divide-[var(--border)] border-y border-[var(--border)]"
      aria-label="Verified public programs"
    >
      {programs.map((program) => (
        <article class="grid lg:grid-cols-[13rem_1fr] gap-5 lg:gap-8 py-7">
          <div>
            <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--primary)]">
              {program.data.lifecycle}
            </div>
            <div class="mt-2 text-xs text-[var(--muted-foreground)]">{program.data.organizer}</div>
          </div>
          <div>
            <h2 class="font-display font-bold text-2xl text-[var(--foreground)]">{program.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">{program.data.summary}</p>
            <a
              href={`/events/${program.data.slug}/`}
              class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline"
            >
              View verified record
              <ArrowRight className="w-4 h-4" aria-hidden="true" />
            </a>

            <dl class="mt-5 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-xs">
              <div class="flex gap-2">
                <dt class="font-mono text-[var(--primary)]">SAM-UP role</dt>
                <dd class="text-[var(--muted-foreground)]">{program.data.samUpRole}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="inline-flex items-center gap-1.5 font-mono text-[var(--primary)]">
                  <Calendar class="w-3.5 h-3.5" aria-hidden="true" />
                  Schedule
                </dt>
                <dd class="text-[var(--muted-foreground)]">{getScheduleLabel(program)}</dd>
              </div>
              {program.data.audience && (
                <div class="flex gap-2">
                  <dt class="inline-flex items-center gap-1.5 font-mono text-[var(--primary)]">
                    <Users className="w-3.5 h-3.5" aria-hidden="true" />
                    Audience
                  </dt>
                  <dd class="text-[var(--muted-foreground)]">{program.data.audience}</dd>
                </div>
              )}
              {program.data.location && (
                <div class="flex gap-2">
                  <dt class="inline-flex items-center gap-1.5 font-mono text-[var(--primary)]">
                    <MapPin className="w-3.5 h-3.5" aria-hidden="true" />
                    Location
                  </dt>
                  <dd class="text-[var(--muted-foreground)]">{program.data.location}</dd>
                </div>
              )}
            </dl>
          </div>
        </article>
      ))}
    </section>
  ) : (
    <section class="grid lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 rounded-[1.5rem] border border-[var(--border)] p-8 sm:p-10">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--primary)]">
          <ShieldCheck className="w-4 h-4" aria-hidden="true" />
          <span>Verification in progress</span>
        </div>
        <h2 class="mt-4 font-display font-bold text-2xl sm:text-3xl text-[var(--foreground)]">
          No legacy program is being labeled current just to make this page look full.
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[var(--muted-foreground)]">
          Existing repository records are checked for ownership, SAM-UP's specific role, schedule, audience,
          and public status. Records remain quarantined until the evidence is publishable.
        </p>
      </div>

      <aside class="lg:col-span-5 border-t border-[var(--border)] pt-6">
        <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--muted-foreground)]">
          Need the latest schedule?
        </div>
        <h2 class="mt-3 font-display font-bold text-2xl text-[var(--foreground)]">
          Use the official announcement channel.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)]">
          The website should not outrun the organization. Check SAM-UP's current public announcement for
          dates, venues, registration, and participation instructions.
        </p>
        <a
          href="https://facebook.com/SAMUPLB"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:underline"
        >
          Official SAM-UP page
          <ExternalLink className="w-4 h-4" aria-hidden="true" />
        </a>
      </aside>
    </section>
  )}
</div>
