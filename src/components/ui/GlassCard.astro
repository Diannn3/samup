---
// Static Astro glass card — zero-hydration rendering of the established
// .frosted-glass-card visual system. Use for all non-featured cards.
// Featured/spotlight cards use the React FrostedGlassCard island instead.
import { ArrowUpRight } from 'lucide-react';

interface Props {
  tag?: string;
  title?: string;
  subtitle?: string;
  href?: string;
  class?: string;
  showArrow?: boolean;
}

const { tag, title, subtitle, href, class: className = '', showArrow = true } = Astro.props;
---

{href ? (
  <a href={href} class="block no-underline focus-visible:outline-none group">
    <div class={`frosted-glass-card p-6 sm:p-7 flex flex-col justify-between h-full ${className}`}>
      <div class="relative z-10 w-full">
        {(tag || showArrow) && (
          <div class="flex items-center justify-between gap-2 mb-3">
            {tag && (
              <span class="text-[11px] font-mono font-bold tracking-widest uppercase text-[var(--primary)] px-2.5 py-0.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20">
                {tag}
              </span>
            )}
            {showArrow && (
              <ArrowUpRight
                class="w-5 h-5 text-[var(--muted-foreground)] group-hover:text-[var(--primary)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all ml-auto shrink-0"
                aria-hidden="true"
              />
            )}
          </div>
        )}
        {title && (
          <h3 class="font-display font-bold text-xl sm:text-2xl text-[var(--foreground)] group-hover:text-white transition-colors tracking-tight leading-snug">
            {title}
          </h3>
        )}
        {subtitle && (
          <p class="text-sm text-[var(--foreground)]/80 mt-2 leading-relaxed font-normal">
            {subtitle}
          </p>
        )}
        <slot />
      </div>
    </div>
  </a>
) : (
  <div class={`frosted-glass-card p-6 sm:p-7 flex flex-col justify-between h-full ${className}`}>
    <div class="relative z-10 w-full">
      {(tag || showArrow) && (
        <div class="flex items-center justify-between gap-2 mb-3">
          {tag && (
            <span class="text-[11px] font-mono font-bold tracking-widest uppercase text-[var(--primary)] px-2.5 py-0.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20">
              {tag}
            </span>
          )}
          {showArrow && (
            <ArrowUpRight
              class="w-5 h-5 text-[var(--muted-foreground)] group-hover:text-[var(--primary)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all ml-auto shrink-0"
              aria-hidden="true"
            />
          )}
        </div>
      )}
      {title && (
        <h3 class="font-display font-bold text-xl sm:text-2xl text-[var(--foreground)] tracking-tight leading-snug">
          {title}
        </h3>
      )}
      {subtitle && (
        <p class="text-sm text-[var(--foreground)]/80 mt-2 leading-relaxed font-normal">
          {subtitle}
        </p>
      )}
      <slot />
    </div>
  </div>
)}
