{
  "name": "sam-up",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "qa:audit": "node scripts/audit-site.mjs",
    "astro": "astro",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:motion": "node scripts/motion-touch-check.mjs",
    "qa:all": "npm run qa:bundle && npm run test:a11y && npm run qa:audit && npm run qa:motion && npm run qa:visual",
    "qa:bundle": "node scripts/check-bundle-budget.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,mjs,css,md}\" \"scripts/**/*.{js,mjs}\" \"docs/**/*.md\" \"*.{md,mjs,cjs}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,js,mjs,css,md}\" \"scripts/**/*.{js,mjs}\" \"docs/**/*.md\" \"*.{md,mjs,cjs}\"",
    "check": "astro check",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "perf:lhci": "lhci autorun --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "lucide-react": "^1.33.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pagefind": "^1.5.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
